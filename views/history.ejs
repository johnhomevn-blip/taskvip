<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Lịch Sử - 4ummo</title>
<link rel="stylesheet" href="/css/style.css?v=<%=assetVersion%>">
<link rel="stylesheet" href="/css/coins.css?v=<%=assetVersion%>">
<script src="/js/menu.js?v=<%=assetVersion%>" defer></script></head><body>
<%- include('partials/sidebar',{page:'history',user}) %>
<%- include('partials/popup') %>
<div class="main" id="main">
  <%- include('partials/topbar') %>
  <div class="topbar"><div class="topbar-title">📋 Lịch Sử</div></div>
  <div class="page">
    <div class="tabs" style="margin-bottom:16px">
      <button class="tab-btn active" onclick="showTab('transactions',this)">💳 Giao dịch</button>
      <button class="tab-btn" onclick="showTab('logins',this)">🔐 Đăng nhập</button>
    </div>

    <div id="tab-transactions">
      <div class="alert alert-info" style="margin-bottom:12px">ℹ️ Lịch sử giao dịch tự động xóa sau 30 ngày.</div>
      <div class="card">
        <table>
          <tr><th>Thời gian</th><th>Loại</th><th>Số lượng</th><th>Mô tả</th></tr>
          <%transactions.forEach(t=>{%>
          <tr>
            <td style="color:var(--text2);font-size:12px"><%=new Date(parseInt(t.created_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td>
              <%if(t.type==='earn'){%><span class="badge badge-success">⚡ Vượt link</span>
              <%}else if(t.type==='earn_pending'){%><span class="badge badge-warning">⏳ Chờ duyệt</span>
              <%}else if(t.type==='earn_rejected'){%><span class="badge badge-danger">❌ Từ chối</span>
              <%}else if(t.type==='withdraw'){%><span class="badge badge-warning">💸 Rút tiền</span>
              <%}else if(t.type==='topup'){%><span class="badge" style="background:rgba(96,165,250,0.15);color:#60a5fa">💎 Nạp</span>
              <%}else if(t.type==='buy'){%><span class="badge badge-danger">🛍️ Mua</span>
              <%}else if(t.type==='referral'){%><span class="badge" style="background:rgba(168,85,247,0.15);color:#a855f7">🤝 Hoa hồng</span>
              <%}else{%><span class="badge"><%=t.type%></span><%}%>
            </td>
            <td style="font-weight:600;color:<%=t.type==='earn'||t.type==='topup'||t.type==='referral'?'#10b981':(t.type==='earn_pending'?'#f59e0b':(t.type==='earn_rejected'?'var(--text3)':'#ef4444'))%>">
              <%=t.type==='earn'||t.type==='topup'||t.type==='referral'?'+':(t.type==='earn_pending'||t.type==='earn_rejected'?'':'-')%><%=t.amount.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%>
              <span style="font-size:11px"><%=t.coin_type==='vcoin'?'V':'N'%></span>
              <%if(t.type==='earn_rejected'){%><span style="font-size:11px;color:var(--text3)"> (không cộng)</span><%}%>
            </td>
            <td style="color:var(--text2);font-size:12px"><%=t.description%></td>
          </tr>
          <%})%>
        </table>
        <%if(transactions.length===0){%><div style="text-align:center;padding:30px;color:var(--text2)">Chưa có giao dịch nào</div><%}%>
      </div>
    </div>

    <div id="tab-logins" style="display:none">
      <div class="alert alert-info" style="margin-bottom:12px">ℹ️ Nhật ký đăng nhập tự động xóa sau 7 ngày.</div>
      <div class="card">
        <table>
          <tr><th>Thời gian</th><th>Địa chỉ IP</th><th>Thiết bị</th></tr>
          <%loginLogs.forEach(l=>{%>
          <tr>
            <td style="color:var(--text2);font-size:12px"><%=new Date(parseInt(l.created_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td><span class="ip-badge"><%=l.ip||'—'%></span></td>
            <td style="color:var(--text2);font-size:11px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%=l.user_agent||'—'%></td>
          </tr>
          <%})%>
        </table>
        <%if(loginLogs.length===0){%><div style="text-align:center;padding:30px;color:var(--text2)">Chưa có nhật ký đăng nhập</div><%}%>
      </div>
    </div>
  </div>
</div>
<script>
function showTab(id, btn) {
  document.getElementById('tab-transactions').style.display='none';
  document.getElementById('tab-logins').style.display='none';
  document.getElementById('tab-'+id).style.display='block';
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
}
</script>
</body></html>
