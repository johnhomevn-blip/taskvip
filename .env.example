# --- Cau hinh chung ---
PORT=3000

# Khuyen nghi manh me: dat 2 secret nay bang chuoi ngau nhien, dai, giu bi mat.
# Co the tao nhanh bang lenh: openssl rand -hex 32
# NEU BAN KHONG SET: server van chay binh thuong (tu sinh ngau nhien luc khoi
# dong), nhung nguoi dung se bi dang xuat va cac link /verify dang cho xu ly se
# mat hieu luc MOI KHI server restart/deploy lai. Nen set co dinh cho on dinh.
SESSION_SECRET=
HMAC_SECRET=

# --- API Key cac nha cung cap rut gon link ---
# Dang ky tai link4m.com -> muc API -> lay key dan vao day
LINK4M_API_KEY=

# Dang ky tai uptolink.net -> muc API -> lay key dan vao day
UPTOLINK_API_KEY=

# --- Ten mien trang cua ban (dung de tao URL xac nhan) ---
# Vi du: https://moneytask-cua-ban.up.railway.app hoac https://domain-cua-ban.com
BASE_URL=http://localhost:3000

# --- Bao mat IP (KHONG bat neu khong chac chan) ---
# Chi bat (=1) NEU ban da chan hoan toan truy cap truc tiep vao domain goc
# (vi du domain *.up.railway.app) va CHI cho phep truy cap qua Cloudflare.
# QUAN TRONG (2026-09): bien nay THOI KHONG CON TU CHAY duoc nua neu thieu
# CF_ORIGIN_SECRET ben duoi - vi chi rieng no (+ CANONICAL_HOST) KHONG DU de
# chan gia mao (header "Host" client tu khai bao duoc). Phai bat CA
# CF_ORIGIN_SECRET thi bien nay moi thuc su co tac dung. Mac dinh de trong (tat).
TRUST_CF_HEADER=

# --- Ep ve dung 1 domain chinh thuc (tien ich UX: tu chuyen huong truy cap
# nham domain goc Railway ve dung domain qua Cloudflare) - dat = ten mien
# That ban dung qua Cloudflare, vd:
#   CANONICAL_HOST=4ummo.com
# Luu y: bien nay CHI la tien ich, KHONG PHAI lop bao ve chinh (xem
# CF_ORIGIN_SECRET ben duoi moi la lop bao ve that su).
CANONICAL_HOST=

# --- LOP BAO VE THAT SU (BAT BUOC neu muon dung TRUST_CF_HEADER) - 1 chuoi
# bi mat tu ban tu tao, dat GIONG HET trong 1 Cloudflare Transform Rule
# (Modify Request Header > Set static > "X-Origin-Secret") de CHI Cloudflare
# moi chen duoc header nay vao request that (client khong the tu gia mao vi
# Cloudflare se ghi de). Neu de trong, TRUST_CF_HEADER se BI VO HIEU HOA tu
# dong (xem lib/ip.js) - IP hien thi se quay ve req.ip thay vi bao gio cung
# tin header Cloudflare mot cach khong an toan. Vao Admin > tab Bao mat de
# xem huong dan tung buoc + chuoi goi y tu sinh san.
CF_ORIGIN_SECRET=

# --- Cloudflare Turnstile (chong bot dang ky/dang nhap/rut tien) ---
# Lay tai dash.cloudflare.com > Turnstile > tao 1 widget cho domain cua ban.
# SITE_KEY la du lieu CONG KHAI (dua vao HTML, ai xem source cung thay duoc).
# SECRET_KEY la BI MAT - CHI dung o server (lib/turnstile.js), TUYET DOI
# KHONG dua ra HTML/JS phia client, khong commit len git cong khai.
# Neu de trong ca 2, Turnstile se TU DONG BI TAT (kem canh bao trong log) de
# moi truong dev/test khong co key van chay duoc - nhung production BAT BUOC
# phai dien day du, khong thi dang ky/dang nhap/rut tien hoan toan khong duoc
# Turnstile bao ve.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
