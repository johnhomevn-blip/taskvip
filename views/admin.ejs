<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin - TaskVip</title>
<link rel="stylesheet" href="/css/style.css">
<script src="/js/menu.js" defer></script></head><body>
<%- include('partials/sidebar',{page:'admin',user}) %>
<div class="main" id="main">
  <%- include('partials/topbar') %>
  <div class="topbar"><div class="topbar-title">⚙️ Admin Panel</div></div>
  <div class="page">
    <%if(error){%><div class="alert alert-error">⚠️ <%=error%></div><%}%>
    <%if(ok){%><div class="alert alert-success">✅ Thao tác thành công!</div><%}%>

    <div class="tabs">
      <button class="tab-btn active" onclick="showTab('tasks')">⚡ Nhiệm vụ</button>
      <button class="tab-btn" onclick="showTab('withdrawals')">💸 Rút tiền</button>
      <button class="tab-btn" onclick="showTab('topup')">💎 Cộng Vcoin</button>
      <button class="tab-btn" onclick="showTab('shop')">🛍️ Sản phẩm</button>
      <button class="tab-btn" onclick="showTab('ranking')">🏆 Đua top</button>
      <button class="tab-btn" onclick="showTab('users')">👥 Users & IP</button>
      <button class="tab-btn" onclick="showTab('announce')">📢 Thông báo</button>
      <button class="tab-btn" onclick="showTab('settings')">⚙️ Cài đặt</button>
    </div>

    <!-- TASKS -->
    <div class="tab-panel active" id="tab-tasks">
      <div class="card" style="margin-bottom:14px">
        <div class="card-title">➕ Thêm danh mục nhiệm vụ</div>
        <form method="POST" action="/admin/categories" style="display:flex;gap:8px;flex-wrap:wrap">
          <input name="name" placeholder="Tên danh mục" class="fg" style="flex:1;min-width:150px;padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" required>
          <input name="icon" placeholder="Icon (emoji)" style="width:80px;padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" value="⚡">
          <input name="sort_order" type="number" placeholder="Thứ tự" style="width:80px;padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" value="0">
          <button class="btn btn-success" type="submit">Thêm</button>
        </form>
      </div>

      <div class="card" style="margin-bottom:14px">
        <div class="card-title">➕ Thêm nhiệm vụ mới</div>
        <form method="POST" action="/admin/tasks" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px">
          <input name="name" placeholder="Tên nhiệm vụ" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" required>
          <select name="category_id" style="padding:9px 12px;background:var(--bg2);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
            <option value="">-- Không có danh mục --</option>
            <%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.icon%> <%=c.name%></option><%})%>
          </select>
          <input name="target_url" placeholder="URL đích" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" required>
          <input name="base_reward" type="number" placeholder="Thưởng (Ncoin)" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" required>
          <input name="exp_reward" type="number" placeholder="EXP" value="1" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <input name="min_seconds" type="number" placeholder="Giây tối thiểu" value="15" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <input name="daily_limit" type="number" placeholder="Lượt/user/ngày" value="2" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <input name="ip_daily_limit" type="number" placeholder="Lượt/IP/ngày" value="2" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <button class="btn btn-primary" type="submit" style="grid-column:1/-1">➕ Thêm nhiệm vụ</button>
        </form>
      </div>

      <div class="card">
        <div class="card-title">📋 Danh sách nhiệm vụ</div>
        <table>
          <tr><th>Tên</th><th>Danh mục</th><th>Thưởng</th><th>Lượt/ngày</th><th>IP/ngày</th><th>Trạng thái</th><th></th></tr>
          <%tasks.forEach(t=>{%>
          <tr>
            <td><%=t.name%></td>
            <td style="color:var(--text2)"><%=t.cat_name||'—'%></td>
            <td style="color:#fbbf24">🪙<%=t.base_reward.toLocaleString('vi-VN')%></td>
            <td><%=t.daily_limit%></td>
            <td><%=t.ip_daily_limit%></td>
            <td><%if(t.active){%><span class="badge badge-success">Bật</span><%}else{%><span class="badge badge-danger">Tắt</span><%}%></td>
            <td style="display:flex;gap:4px;flex-wrap:wrap">
              <form method="POST" action="/admin/tasks/<%=t.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=t.active?'Tắt':'Bật'%></button></form>
              <form method="POST" action="/admin/tasks/<%=t.id%>/delete" onsubmit="return confirm('Xóa nhiệm vụ này?')"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <%})%>
        </table>
      </div>
    </div>

    <!-- WITHDRAWALS -->
    <div class="tab-panel" id="tab-withdrawals">
      <div class="card">
        <div class="card-title">💸 Yêu cầu rút tiền chờ duyệt (<%=withdrawals.length%>)</div>
        <table>
          <tr><th>User</th><th>Số tiền</th><th>Phương thức</th><th>Thông tin</th><th>Ngày</th><th></th></tr>
          <%withdrawals.forEach(w=>{%>
          <tr>
            <td><b><%=w.username%></b></td>
            <td style="color:#fbbf24;font-weight:600">🪙<%=w.amount.toLocaleString('vi-VN')%></td>
            <td><%=w.method%></td>
            <td style="font-size:12px;color:var(--text2)"><%=w.detail%></td>
            <td style="color:var(--text2);font-size:12px"><%=new Date(parseInt(w.created_at)).toLocaleDateString('vi-VN')%></td>
            <td style="display:flex;gap:4px">
              <form method="POST" action="/admin/withdrawals/<%=w.id%>/approve"><button class="btn btn-sm btn-success" type="submit">✅ Duyệt</button></form>
              <form method="POST" action="/admin/withdrawals/<%=w.id%>/reject"><button class="btn btn-sm btn-danger" type="submit">❌ Từ chối</button></form>
            </td>
          </tr>
          <%})%>
        </table>
        <%if(withdrawals.length===0){%><div style="text-align:center;padding:20px;color:var(--text2)">Không có yêu cầu nào</div><%}%>
      </div>
    </div>

    <!-- TOPUP -->
    <div class="tab-panel" id="tab-topup">
      <div class="card">
        <div class="card-title">💎 Cộng Vcoin cho user</div>
        <form method="POST" action="/admin/topup" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px">
          <select name="user_id" style="padding:9px 12px;background:var(--bg2);border:1px solid var(--card-border);border-radius:10px;color:var(--text);flex:1;min-width:150px">
            <%users.forEach(u=>{%><option value="<%=u.id%>"><%=u.username%> (💎<%=u.vcoin%>V)</option><%})%>
          </select>
          <input name="amount" type="number" placeholder="Số Vcoin" style="width:120px;padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" required>
          <input name="note" placeholder="Ghi chú" style="flex:1;min-width:150px;padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <button class="btn btn-primary" type="submit">💎 Cộng Vcoin</button>
        </form>
      </div>
    </div>

    <!-- SHOP -->
    <div class="tab-panel" id="tab-shop">
      <div class="card" style="margin-bottom:14px">
        <div class="card-title">➕ Thêm sản phẩm</div>
        <form method="POST" action="/admin/products" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px">
          <input name="name" placeholder="Tên sản phẩm" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" required>
          <input name="description" placeholder="Mô tả" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <input name="price_ncoin" type="number" placeholder="Giá Ncoin" value="0" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <input name="price_vcoin" type="number" placeholder="Giá Vcoin" value="0" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <input name="stock" type="number" placeholder="Số lượng (-1=vô hạn)" value="-1" style="padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)">
          <button class="btn btn-primary" type="submit">➕ Thêm</button>
        </form>
      </div>
      <div class="card" style="margin-bottom:14px">
        <div class="card-title">📦 Đơn hàng chờ xử lý (<%=orders.length%>)</div>
        <table>
          <tr><th>User</th><th>Sản phẩm</th><th>Giá</th><th>Ngày</th><th></th></tr>
          <%orders.forEach(o=>{%>
          <tr>
            <td><%=o.username%></td><td><%=o.pname%></td>
            <td><%if(o.price_ncoin>0){%>🪙<%=o.price_ncoin.toLocaleString('vi-VN')%>N<%}%><%if(o.price_vcoin>0){%> 💎<%=o.price_vcoin.toLocaleString('vi-VN')%>V<%}%></td>
            <td style="color:var(--text2)"><%=new Date(parseInt(o.created_at)).toLocaleDateString('vi-VN')%></td>
            <td style="display:flex;gap:4px">
              <form method="POST" action="/admin/orders/<%=o.id%>/done"><button class="btn btn-sm btn-success" type="submit">✅</button></form>
              <form method="POST" action="/admin/orders/<%=o.id%>/reject"><button class="btn btn-sm btn-danger" type="submit">❌</button></form>
            </td>
          </tr>
          <%})%>
        </table>
        <%if(orders.length===0){%><div style="text-align:center;padding:16px;color:var(--text2)">Không có đơn hàng nào</div><%}%>
      </div>
      <div class="card">
        <div class="card-title">📋 Danh sách sản phẩm</div>
        <table>
          <tr><th>Tên</th><th>Giá N</th><th>Giá V</th><th>Kho</th><th>Trạng thái</th><th></th></tr>
          <%products.forEach(p=>{%>
          <tr>
            <td><%=p.name%></td>
            <td style="color:#fbbf24"><%=p.price_ncoin>0?p.price_ncoin.toLocaleString('vi-VN'):'—'%></td>
            <td style="color:#60a5fa"><%=p.price_vcoin>0?p.price_vcoin.toLocaleString('vi-VN'):'—'%></td>
            <td><%=p.stock===-1?'∞':p.stock%></td>
            <td><%if(p.active){%><span class="badge badge-success">Bật</span><%}else{%><span class="badge badge-danger">Tắt</span><%}%></td>
            <td><form method="POST" action="/admin/products/<%=p.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=p.active?'Tắt':'Bật'%></button></form></td>
          </tr>
          <%})%>
        </table>
      </div>
    </div>

    <!-- RANKING -->
    <div class="tab-panel" id="tab-ranking">
      <div class="card">
        <div class="card-title">🏆 Cài đặt đua top</div>
        <form method="POST" action="/admin/settings">
          <div class="fg"><label>Phần thưởng hạng 1 (đ)</label><input name="weekly_reward_1" type="number" value="<%=settings.weekly_reward_1||50000%>"></div>
          <div class="fg"><label>Phần thưởng hạng 2 (đ)</label><input name="weekly_reward_2" type="number" value="<%=settings.weekly_reward_2||30000%>"></div>
          <div class="fg"><label>Phần thưởng hạng 3 (đ)</label><input name="weekly_reward_3" type="number" value="<%=settings.weekly_reward_3||20000%>"></div>
          <div class="fg"><label>Bật/tắt đua top</label>
          <select name="ranking_enabled"><option value="1" <%=settings.ranking_enabled==='1'?'selected':''%>>Bật</option><option value="0" <%=settings.ranking_enabled!=='1'?'selected':''%>>Tắt</option></select></div>
          <button class="btn btn-primary" type="submit">💾 Lưu</button>
        </form>
      </div>
    </div>

    <!-- USERS & IP -->
    <div class="tab-panel" id="tab-users">
      <div class="card">
        <div class="card-title">👥 Danh sách users</div>
        <table>
          <tr><th>ID</th><th>Username</th><th>Ncoin</th><th>Vcoin</th><th>Level</th><th>IP đăng ký</th><th></th></tr>
          <%users.forEach(u=>{%>
          <tr>
            <td style="color:var(--text2)"><%=u.id%></td>
            <td><b><%=u.username%></b></td>
            <td style="color:#fbbf24"><%=u.ncoin.toLocaleString('vi-VN')%></td>
            <td style="color:#60a5fa"><%=u.vcoin.toLocaleString('vi-VN')%></td>
            <td>Lv.<%=u.level%></td>
            <td style="font-size:11px;color:var(--text2)"><%=u.reg_ip||'—'%></td>
            <td><a href="/admin/user/<%=u.id%>/ips" class="btn btn-sm btn-outline">🔍 Xem IP</a></td>
          </tr>
          <%})%>
        </table>
      </div>
    </div>

    <!-- ANNOUNCEMENTS -->
    <div class="tab-panel" id="tab-announce">
      <div class="card" style="margin-bottom:14px">
        <div class="card-title">➕ Thêm thông báo</div>
        <form method="POST" action="/admin/announcements" style="display:flex;gap:8px">
          <input name="content" placeholder="Nội dung thông báo..." style="flex:1;padding:9px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text)" required>
          <button class="btn btn-primary" type="submit">Thêm</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">📢 Danh sách thông báo</div>
        <table>
          <tr><th>Nội dung</th><th>Trạng thái</th><th></th></tr>
          <%announcements.forEach(a=>{%>
          <tr>
            <td><%=a.content%></td>
            <td><%if(a.active){%><span class="badge badge-success">Hiển thị</span><%}else{%><span class="badge">Ẩn</span><%}%></td>
            <td style="display:flex;gap:4px">
              <form method="POST" action="/admin/announcements/<%=a.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=a.active?'Ẩn':'Hiện'%></button></form>
              <form method="POST" action="/admin/announcements/<%=a.id%>/delete"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <%})%>
        </table>
      </div>
    </div>

    <!-- SETTINGS -->
    <div class="tab-panel" id="tab-settings">
      <div class="card">
        <div class="card-title">⚙️ Cài đặt chung</div>
        <form method="POST" action="/admin/settings">
          <div class="fg"><label>Ncoin rút tối thiểu</label><input name="withdraw_min" type="number" value="<%=settings.withdraw_min||20000%>"></div>
          <div class="fg"><label>Thông báo trang rút tiền</label><textarea name="withdraw_notice" rows="3"><%=settings.withdraw_notice||''%></textarea></div>
          <div class="fg"><label>Thông báo trang nạp Vcoin</label><textarea name="topup_notice" rows="3"><%=settings.topup_notice||''%></textarea></div>
          <button class="btn btn-primary" type="submit">💾 Lưu cài đặt</button>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
function showTab(id) {
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  event.target.classList.add('active');
}
// Hien thi tab theo hash URL
const hash = location.hash.replace('#','');
if(hash) { const btn = document.querySelector(`.tab-btn[onclick="showTab('${hash}')"]`); if(btn) showTab(hash), btn.classList.add('active'), document.querySelectorAll('.tab-btn').forEach(b=>{if(b!==btn)b.classList.remove('active')}); }
</script>
</body></html>
