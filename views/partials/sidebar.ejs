<div class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <svg width="36" height="36" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
      <defs><linearGradient id="logoGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#7c3aed"/><stop offset="1" stop-color="#ec4899"/>
      </linearGradient></defs>
      <rect width="36" height="36" rx="10" fill="url(#logoGrad)"/>
      <path d="M20.5 7L11 20.5h5.5L15 29l9.5-13.5H19z" fill="#fff"/>
    </svg>
    <div>
      <h1>4ummo</h1>
      <p>Kiếm tiền online</p>
    </div>
  </div>
  <div class="sidebar-user">
    <div class="user-info">
      <div class="user-avatar"><%= user.username[0].toUpperCase() %></div>
      <div>
        <div class="user-name"><%= user.username %></div>
        <span class="level-tag" style="background:<%=user.levelTag.bg%>;color:#fff">
          <%=user.levelTag.emoji%> Lv.<%=user.level%> <%=user.levelTag.label%>
        </span>
      </div>
    </div>
    <div class="coins-row">
      <div class="coin-pill ncoin"><span class="ni">N</span> <%=user.ncoin.toLocaleString('vi-VN')%>N</div>
      <div class="coin-pill vcoin"><span class="vi">V</span> <%=user.vcoin.toLocaleString('vi-VN')%>V</div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Tổng quan</div>
    <a href="/dashboard" class="nav-item <%=page==='dashboard'?'active':''%>"><span class="ni2">📊</span> Dashboard</a>
    <div class="nav-section">Kiếm tiền</div>
    <a href="/tasks" class="nav-item <%=page==='tasks'?'active':''%>"><span class="ni2">⚡</span> Nhiệm Vụ</a>
    <a href="/shop" class="nav-item <%=page==='shop'?'active':''%>"><span class="ni2">🛍️</span> Quy Đổi</a>
    <a href="/ranking" class="nav-item <%=page==='ranking'?'active':''%>"><span class="ni2">🏆</span> Đua Top</a>
    <div class="nav-section">Tài chính</div>
    <a href="/wallet" class="nav-item <%=page==='wallet'?'active':''%>"><span class="ni2">💸</span> Rút Tiền</a>
    <a href="/topup" class="nav-item <%=page==='topup'?'active':''%>"><span class="ni2">💎</span> Nạp Vcoin</a>
    <a href="/history" class="nav-item <%=page==='history'?'active':''%>"><span class="ni2">📋</span> Lịch Sử</a>
    <div class="nav-section">Cá nhân</div>
    <a href="/account" class="nav-item <%=page==='account'?'active':''%>"><span class="ni2">👤</span> Tài Khoản</a>
    <a href="/regulations" class="nav-item <%=page==='regulations'?'active':''%>"><span class="ni2">📜</span> Quy Định</a>
    <%if(user.is_admin){%>
    <div class="nav-section">Quản trị</div>
    <a href="/admin" class="nav-item <%=page==='admin'?'active':''%>"><span class="ni2">⚙️</span> Admin Panel</a>
    <%}%>
  </nav>
  <div class="sidebar-bottom">
    <form method="POST" action="/logout">
      <button type="submit" class="btn-logout">🚪 Đăng xuất</button>
    </form>
  </div>
</div>
<div class="sidebar-overlay" id="overlay" onclick="toggleMenu()"></div>
