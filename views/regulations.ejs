<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Quy Định - 4ummo</title>
<link rel="stylesheet" href="/css/style.css?v=<%=assetVersion%>">
<link rel="stylesheet" href="/css/coins.css?v=<%=assetVersion%>">
<script src="/js/menu.js?v=<%=assetVersion%>" defer></script></head><body>
<%- include('partials/sidebar',{page:'regulations',user}) %>
<%- include('partials/popup') %>
<div class="main" id="main">
  <%- include('partials/topbar') %>
  <div class="topbar"><div class="topbar-title">📜 Quy Định Sử Dụng</div></div>
  <div class="page">
    <%if(regs.length===0){%>
    <div class="card" style="text-align:center;padding:40px">
      <div style="font-size:40px;margin-bottom:12px">📜</div>
      <div style="color:var(--text2)">Chưa có quy định nào. Admin sẽ cập nhật sớm.</div>
    </div>
    <%}else{%>
    <header class="rules-hero">
      <h1>Luật chơi ở 4ummo</h1>
      <p><%=regs.length%> điều ngắn gọn. Đọc một lần để không bị mất thưởng oan.</p>
      <nav class="rules-toc" aria-label="Mục lục quy định">
        <%regs.forEach((r,i)=>{%>
        <a class="toc-chip" href="#dieu-<%=i+1%>"><b><%=String(i+1).padStart(2,'0')%></b><span><%=r.title%></span></a>
        <%})%>
      </nav>
    </header>
    <div class="rules-rail">
      <%regs.forEach((r,i)=>{%>
      <div class="rule-item" style="--i:<%=i%>">
        <span class="rule-node" aria-hidden="true"></span>
        <section class="rule-card" id="dieu-<%=i+1%>">
          <span class="rule-num" aria-hidden="true"><%=String(i+1).padStart(2,'0')%></span>
          <div class="rule-kicker">Điều <%=i+1%></div>
          <h2 class="rule-title"><%=r.title%></h2>
          <%- r.html %>
        </section>
      </div>
      <%})%>
    </div>
    <%}%>
  </div>
</body></html>
