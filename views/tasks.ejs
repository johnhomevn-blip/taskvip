<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Nhiệm Vụ - 4ummo</title>
<%- include('partials/theme-head') %>
<link rel="stylesheet" href="/css/style.css?v=<%=assetVersion%>">
<link rel="stylesheet" href="/css/coins.css?v=<%=assetVersion%>">
<script src="/js/menu.js?v=<%=assetVersion%>" defer></script></head><body>
<%- include('partials/sidebar',{page:'tasks',user}) %>
<%- include('partials/popup') %>
<div class="main" id="main">
  <%- include('partials/topbar') %>
  <div class="topbar">
    <div class="topbar-title">⚡ Nhiệm Vụ Vượt Link</div>
    <span class="ip-badge">🌐 <%=userIP%></span>
  </div>
  <div class="page">
    <%if(error){%><div class="alert alert-error">⚠️ <%=error%></div><%}%>
    <%if(done){%><div class="alert alert-success">✅ Hoàn thành! Ncoin đã cộng vào tài khoản.</div><%}%>
    <%announcements.forEach(a=>{%><div class="announce">📢 <%=a.content%></div><%})%>

    <%- include('partials/ads/banner300') %>
    <%- include('partials/ads/native') %>

    <div class="multiplier-bar">
      <div>
        <div class="mult-lbl">Hệ số nhân hiện tại</div>
        <div class="mult-val">×<%=multiplier%></div>
        <div class="mult-lbl">Reset sau: <span class="countdown-txt" id="cd"></span></div>
      </div>
      <div style="text-align:right;font-size:12px;color:var(--text2)">
        <div>0:00 GMT+7 = ×1.07</div>
        <div style="margin-top:3px">Giảm 0.005 mỗi giờ</div>
      </div>
    </div>

    <div class="task-notes">
      <div class="task-notes-title">Trước khi làm nhiệm vụ</div>
      <div class="tips-grid">
        <div class="tip">
          <span class="tip-ic" aria-hidden="true">🔎</span>
          <div><strong>Có nhiệm vụ được kiểm tra thủ công.</strong> Admin sẽ đối chiếu với nhà cung cấp trước khi cộng thưởng. Nếu bên đó không ghi nhận lượt của bạn, lượt sẽ bị từ chối.</div>
        </div>
        <div class="tip">
          <span class="tip-ic" aria-hidden="true">📜</span>
          <div><strong>Đọc qua <a href="/regulations">quy định</a> một lần.</strong> Làm đúng luật thì thưởng về ví nhanh và rút tiền không bị vướng.</div>
        </div>
        <div class="tip">
          <span class="tip-ic" aria-hidden="true">🎥</span>
          <div><strong>Gặp lỗi thì chụp màn hình và quay video.</strong> Gửi kèm cho Admin, không có bằng chứng thì bên mình khó kiểm tra giúp bạn.</div>
        </div>
        <div class="tip">
          <span class="tip-ic" aria-hidden="true">🎯</span>
          <div><strong>Tập trung làm ở 4ummo.</strong> Không làm song song cùng một lượt trên nhiều web khác nhau.</div>
        </div>
      </div>
      <div class="note-legend">
        <span class="legend-lbl">Kết quả sau khi vượt link:</span>
        <span class="legend-item"><i class="dot ok"></i>Tiền vào ví ngay</span>
        <span class="legend-item"><i class="dot wait"></i>Đang chờ duyệt</span>
        <span class="legend-item"><i class="dot no"></i>Bị từ chối, không cộng tiền</span>
      </div>
    </div>

    <%grouped.forEach(cat=>{if(!cat.tasks||cat.tasks.length===0)return;%>
    <div style="margin-bottom:20px">
      <div style="font-size:14px;font-weight:600;margin-bottom:10px"><%=cat.icon%> <%=cat.name%></div>
      <div class="task-grid">
        <%cat.tasks.forEach(task=>{%>
        <div class="task-card">
          <div class="task-head">
            <div class="task-name"><%=task.name%></div>
            <span class="provider-tag"><%=task.provider%></span>
          </div>
          <form method="POST" action="/tasks/<%=task.id%>/start">
            <input type="hidden" name="fingerprint" class="fp-input">
            <button class="btn-task" <%=task.remaining<=0?'disabled':''%>><%=task.remaining<=0?'🔒 Hết lượt':'▶ Lấy link vượt'%></button>
          </form>
          <div class="task-footer">
            <div class="task-stat-item"><div class="tsv"><span class="ni sm">N</span><%=task.actualReward.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></div><div class="tsl">Ncoin</div></div>
            <div class="task-stat-item"><div class="tsv">⭐<%=task.exp_reward%></div><div class="tsl">EXP</div></div>
            <div class="task-stat-item"><div class="tsv"><%=task.remaining%>/<%=task.daily_limit%></div><div class="tsl">Lượt còn</div></div>
          </div>
        </div>
        <%})%>
      </div>
    </div>
    <%})%>

    <%if(uncategorized&&uncategorized.length>0){%>
    <div class="task-grid">
      <%uncategorized.forEach(task=>{%>
      <div class="task-card">
        <div class="task-head"><div class="task-name"><%=task.name%></div><span class="provider-tag"><%=task.provider%></span></div>
        <form method="POST" action="/tasks/<%=task.id%>/start">
          <input type="hidden" name="fingerprint" class="fp-input">
          <button class="btn-task" <%=task.remaining<=0?'disabled':''%>><%=task.remaining<=0?'🔒 Hết lượt':'▶ Lấy link vượt'%></button>
        </form>
        <div class="task-footer">
          <div class="task-stat-item"><div class="tsv"><span class="ni sm">N</span><%=task.actualReward.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></div><div class="tsl">Ncoin</div></div>
          <div class="task-stat-item"><div class="tsv">⭐<%=task.exp_reward%></div><div class="tsl">EXP</div></div>
          <div class="task-stat-item"><div class="tsv"><%=task.remaining%>/<%=task.daily_limit%></div><div class="tsl">Lượt còn</div></div>
        </div>
      </div>
      <%})%>
    </div>
    <%}%>
    <%if(grouped.every(g=>!g.tasks||g.tasks.length===0)&&(!uncategorized||uncategorized.length===0)){%>
    <div class="card" style="text-align:center;padding:40px"><div style="font-size:40px;margin-bottom:12px">🔍</div><div style="color:var(--text2)">Chưa có nhiệm vụ nào!</div></div>
    <%}%>
  </div>
</div>
<script>
let s=<%=secondsUntilReset%>;
const el=document.getElementById('cd');
function fmt(x){const h=Math.floor(x/3600),m=Math.floor((x%3600)/60),sc=x%60;return`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sc).padStart(2,'0')}`}
if(el){el.textContent=fmt(s);setInterval(()=>{if(s>0){s--;el.textContent=fmt(s);}},1000);}
const fp=[navigator.userAgent,screen.width+'x'+screen.height,navigator.language].join('|');
const fpVal=btoa(fp).slice(0,32);
document.querySelectorAll('.fp-input').forEach(e=>e.value=fpVal);
</script>
<%- include('partials/adblock-detect') %>
</body></html>
