  <svg width="36" height="36" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
    <defs><linearGradient id="menuLogoGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7c3aed"/><stop offset="1" stop-color="#ec4899"/>
    </linearGradient></defs>
    <rect width="36" height="36" rx="10" fill="url(#menuLogoGrad)"/>
    <path d="M20.5 7L11 20.5h5.5L15 29l9.5-13.5H19z" fill="#fff"/>
