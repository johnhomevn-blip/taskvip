<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Giới Thiệu - 4ummo</title>
<link rel="stylesheet" href="/css/style.css?v=<%=assetVersion%>"><link rel="stylesheet" href="/css/coins.css?v=<%=assetVersion%>">
<script src="/js/menu.js?v=<%=assetVersion%>" defer></script></head><body>
<%- include('partials/sidebar',{page:'referral',user}) %><%- include('partials/popup') %>
<div class="main" id="main"><%- include('partials/topbar') %>
<div class="topbar"><div class="topbar-title">🎁 Giới Thiệu Bạn Bè</div></div>
<div class="page">

<div class="card" style="margin-bottom:16px">
  <div class="card-title">🔗 Link giới thiệu của bạn</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <input id="refLinkInput" readonly value="<%=referralLink%>" style="flex:1;min-width:220px;padding:10px 13px;background:rgba(255,255,255,0.04);border:1px solid var(--card-border);border-radius:10px;color:var(--text);font-size:13px">
    <button class="btn btn-primary" onclick="copyRefLink()" id="copyBtn">📋 Copy link</button>
  </div>
  <div style="font-size:12px;color:var(--text2);margin-top:8px">Mã giới thiệu: <b style="color:var(--text)"><%=referralCode%></b> — chia sẻ link hoặc mã này, khi bạn bè đăng ký và làm nhiệm vụ, bạn sẽ nhận hoa hồng.</div>
</div>

<div class="grid3" style="margin-bottom:16px">
  <div class="card" style="text-align:center">
    <div style="font-size:22px;font-weight:700;color:var(--accent2)"><%=totalReferred%></div>
    <div style="font-size:12px;color:var(--text2)">Tổng số đã giới thiệu</div>
  </div>
  <div class="card" style="text-align:center">
    <div style="font-size:22px;font-weight:700;color:#f59e0b"><%=totalCommission.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%>N</div>
    <div style="font-size:12px;color:var(--text2)">Tổng hoa hồng đã nhận</div>
  </div>
  <div class="card" style="text-align:center">
    <div style="font-size:22px;font-weight:700;color:#10b981"><%=currentRate%>%</div>
    <div style="font-size:12px;color:var(--text2)">Tỷ lệ hoa hồng hiện tại (đã khóa vĩnh viễn)</div>
  </div>
</div>

<div class="card" style="margin-bottom:16px">
  <div class="card-title">🏅 Bậc hoa hồng (mở khóa vĩnh viễn theo tổng số người đã giới thiệu)</div>
  <div class="grid3">
    <div style="text-align:center;padding:12px;border-radius:12px;border:1px solid var(--card-border);<%=tier>=1?'background:rgba(16,185,129,0.1)':''%>">
      <div style="font-size:20px">🔵</div>
      <div style="font-weight:700"><%=rates.r1%>%</div>
      <div style="font-size:11px;color:var(--text2)">1 - <%=thresholds.t2-1%> người</div>
      <%if(tier>=1){%><div style="font-size:11px;color:#10b981;margin-top:4px">✅ Đã mở khóa</div><%}%>
    </div>
    <div style="text-align:center;padding:12px;border-radius:12px;border:1px solid var(--card-border);<%=tier>=2?'background:rgba(16,185,129,0.1)':''%>">
      <div style="font-size:20px">🥈</div>
      <div style="font-weight:700"><%=rates.r2%>%</div>
      <div style="font-size:11px;color:var(--text2)"><%=thresholds.t2%> - <%=thresholds.t3-1%> người</div>
      <%if(tier>=2){%><div style="font-size:11px;color:#10b981;margin-top:4px">✅ Đã mở khóa</div><%}else{%><div style="font-size:11px;color:var(--text2);margin-top:4px">🔒 Cần thêm <%=Math.max(0,thresholds.t2-totalReferred)%> người</div><%}%>
    </div>
    <div style="text-align:center;padding:12px;border-radius:12px;border:1px solid var(--card-border);<%=tier>=3?'background:rgba(16,185,129,0.1)':''%>">
      <div style="font-size:20px">👑</div>
      <div style="font-weight:700"><%=rates.r3%>%</div>
      <div style="font-size:11px;color:var(--text2)">Từ <%=thresholds.t3%> người</div>
      <%if(tier>=3){%><div style="font-size:11px;color:#10b981;margin-top:4px">✅ Đã mở khóa</div><%}else{%><div style="font-size:11px;color:var(--text2);margin-top:4px">🔒 Cần thêm <%=Math.max(0,thresholds.t3-totalReferred)%> người</div><%}%>
    </div>
  </div>
  <div style="font-size:11px;color:var(--text2);margin-top:10px">⚠️ Khi đã đạt 1 bậc, tỷ lệ hoa hồng được giữ nguyên vĩnh viễn cho bạn dù sau này số người giới thiệu thay đổi.</div>
</div>

<%if(!rankingEnabled){%>
<div class="card" style="text-align:center;padding:40px"><div style="font-size:40px;margin-bottom:12px">🎁</div><div style="color:var(--text2)">Tính năng bảng xếp hạng giới thiệu theo tháng đang tắt. Bạn vẫn nhận hoa hồng bình thường.</div></div>
<%}else{%>
<div class="multiplier-bar" style="margin-bottom:16px">
  <div><div class="mult-lbl">Tháng kết thúc sau</div><div class="mult-val" id="rc" style="font-size:22px">--</div></div>
  <div style="text-align:right"><div class="mult-lbl">Vị trí của bạn tháng này</div><div style="font-size:22px;font-weight:700;color:var(--accent2)">#<%=myRank||'—'%></div></div>
</div>
<div class="card" style="margin-bottom:16px">
  <div class="card-title">🎁 Phần thưởng top giới thiệu tháng</div>
  <div class="grid3">
    <%[['🥇',rewards.r1,'rgba(245,158,11,0.1)','rgba(245,158,11,0.2)','#fbbf24','Hạng 1'],['🥈',rewards.r2,'rgba(156,163,175,0.1)','rgba(156,163,175,0.2)','#d1d5db','Hạng 2'],['🥉',rewards.r3,'rgba(180,83,9,0.1)','rgba(180,83,9,0.2)','#d97706','Hạng 3']].forEach(([icon,val,bg,border,color,label])=>{%>
    <div style="text-align:center;padding:12px;background:<%=bg%>;border-radius:12px;border:1px solid <%=border%>">
      <div style="font-size:24px"><%=icon%></div>
      <div style="font-weight:700;color:<%=color%>"><%=(val||0).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%>đ</div>
      <div style="font-size:11px;color:var(--text2)"><%=label%></div>
    </div>
    <%})%>
  </div>
</div>
<div class="card-title" style="margin:0 0 8px 4px">Top giới thiệu tháng này</div>
<%leaderboard.forEach((r,i)=>{%>
<div class="rank-row">
  <div class="rank-badge <%=i===0?'rb1':i===1?'rb2':i===2?'rb3':'rbx'%>"><%=i===0?'🥇':i===1?'🥈':i===2?'🥉':i+1%></div>
  <div class="rank-info">
    <div class="rank-name"><%=r.maskedName%></div>
    <div class="rank-count">👥 <%=r.ref_count%> người được giới thiệu</div>
  </div>
  <%if(i<3&&[rewards.r1,rewards.r2,rewards.r3][i]){%><div class="rank-prize">+<%=[rewards.r1,rewards.r2,rewards.r3][i].toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%>đ</div><%}%>
</div>
<%})%>
<%if(leaderboard.length===0){%><div class="card" style="text-align:center;padding:30px"><div style="color:var(--text2)">Chưa có ai giới thiệu trong tháng này. Hãy là người đầu tiên!</div></div><%}%>
<%}%>

<%if(referredUsers.length>0){%>
<div class="card" style="margin-top:16px">
  <div class="card-title">👥 Người bạn đã giới thiệu (30 gần nhất)</div>
  <table>
    <tr><th>Tài khoản</th><th>Ngày tham gia</th></tr>
    <%referredUsers.forEach(u=>{%>
    <tr><td><%=u.maskedName%></td><td style="color:var(--text2);font-size:12px"><%=new Date(parseInt(u.created_at)).toLocaleDateString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td></tr>
    <%})%>
  </table>
</div>
<%}%>

</div></div>
<script>
function copyRefLink(){
  const input=document.getElementById('refLinkInput');
  input.select(); input.setSelectionRange(0,99999);
  navigator.clipboard.writeText(input.value).then(()=>{
    const btn=document.getElementById('copyBtn');
    const old=btn.textContent; btn.textContent='✅ Đã copy!';
    setTimeout(()=>btn.textContent=old,1500);
  }).catch(()=>document.execCommand('copy'));
}
<%if(rankingEnabled){%>
let s=<%=secondsLeft%>;const el=document.getElementById('rc');
if(el){function fmt(x){const d=Math.floor(x/86400),h=Math.floor((x%86400)/3600),m=Math.floor((x%3600)/60),sc=x%60;return d>0?`${d}n ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`:`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sc).padStart(2,'0')}`}
el.textContent=fmt(s);setInterval(()=>{if(s>0){s--;el.textContent=fmt(s);}},1000);}
<%}%>
</script>
</body></html>
