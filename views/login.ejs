<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Đăng nhập - 4ummo</title>
<link rel="stylesheet" href="/css/style.css"></head><body>
<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-logo">
      <svg width="52" height="52" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" style="margin:0 auto 10px;display:block">
        <defs><linearGradient id="logoGradAuth" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7c3aed"/><stop offset="1" stop-color="#ec4899"/>
        </linearGradient></defs>
        <rect width="36" height="36" rx="10" fill="url(#logoGradAuth)"/>
        <path d="M20.5 7L11 20.5h5.5L15 29l9.5-13.5H19z" fill="#fff"/>
      </svg>
      <h1>4ummo</h1>
      <p style="color:var(--text2);font-size:13px;margin-top:4px">Kiếm tiền online mỗi ngày</p>
    </div>
    <% if(error){%><div class="alert alert-error">⚠️ <%=error%></div><%}%>
    <form method="POST" action="/login">
      <div class="fg"><label>Tên đăng nhập</label><input name="username" required placeholder="Nhập tên đăng nhập"></div>
      <div class="fg"><label>Mật khẩu</label><input type="password" name="password" required placeholder="Nhập mật khẩu"></div>
      <button class="btn btn-primary btn-full" type="submit">Đăng nhập</button>
    </form>
    <p style="text-align:center;margin-top:16px;font-size:13px;color:var(--text2)">
      Chưa có tài khoản? <a href="/register" style="color:var(--primary2)">Đăng ký ngay</a>
    </p>
  </div>
</div></body></html>
