<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tài Khoản - 4ummo</title>
<link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/coins.css">
<script src="/js/menu.js" defer></script></head><body>
<%- include('partials/sidebar',{page:'account',user}) %><%- include('partials/popup') %>
<div class="main" id="main"><%- include('partials/topbar') %>
<div class="topbar"><div class="topbar-title">👤 Tài Khoản</div></div>
<div class="page">
<%if(error){%><div class="alert alert-error">⚠️ <%=error%></div><%}%>
<%if(ok){%><div class="alert alert-success">✅ Đổi mật khẩu thành công!</div><%}%>
<div class="grid2">
  <div class="card">
    <div style="text-align:center;margin-bottom:20px">
      <div style="width:72px;height:72px;border-radius:50%;background:var(--gradient);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;margin:0 auto 12px"><%=user.username[0].toUpperCase()%></div>
      <div style="font-size:18px;font-weight:700"><%=user.username%></div>
      <span class="level-tag" style="background:<%=tag.bg%>;color:#fff;font-size:13px;padding:4px 14px;margin-top:6px;display:inline-flex"><%=tag.emoji%> Level <%=levelInfo.level%> — <%=tag.label%></span>
    </div>
    <div class="exp-bar-wrap" style="margin-bottom:16px">
      <div class="exp-bar-info">
        <span>Level <%=levelInfo.level%></span>
        <span><%=levelInfo.expInLevel.toLocaleString('vi-VN')%>/<%=levelInfo.expNeeded>0?levelInfo.expNeeded.toLocaleString('vi-VN'):'MAX'%> EXP</span>
        <%if(levelInfo.level<50){%><span>→ Lv.<%=levelInfo.level+1%></span><%}%>
      </div>
      <div class="exp-bar-track"><div class="exp-bar-fill" style="width:<%=levelInfo.expNeeded>0?Math.min(100,Math.round(levelInfo.expInLevel/levelInfo.expNeeded*100)):100%>%"></div></div>
      <div style="font-size:11px;color:var(--text2);margin-top:3px">Tổng <%=user.exp.toLocaleString('vi-VN')%> EXP</div>
    </div>
    <div style="font-size:13px">
      <%[['🪙 Ncoin',user.ncoin.toLocaleString('vi-VN')+'N','#f59e0b'],['💎 Vcoin',user.vcoin.toLocaleString('vi-VN')+'V','#60a5fa'],['📅 Tham gia',new Date(parseInt(user.created_at)).toLocaleDateString('vi-VN'),'var(--text)'],['🌐 IP đăng ký',user.reg_ip||'—','var(--text2)']].forEach(([label,val,color])=>{%>
      <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--card-border)">
        <span style="color:var(--text2)"><%=label%></span><b style="color:<%=color%>"><%=val%></b>
      </div>
      <%})%>
    </div>
  </div>
  <div class="card">
    <div class="card-title">🔑 Đổi mật khẩu</div>
    <form method="POST" action="/account/password">
      <div class="fg"><label>Mật khẩu hiện tại</label><input type="password" name="old_password" required placeholder="Nhập mật khẩu hiện tại"></div>
      <div class="fg"><label>Mật khẩu mới</label><input type="password" name="new_password" required placeholder="Tối thiểu 6 ký tự"></div>
      <div class="fg"><label>Nhập lại mật khẩu mới</label><input type="password" name="new_password2" required placeholder="Nhập lại"></div>
      <button class="btn btn-primary btn-full" type="submit">🔑 Đổi mật khẩu</button>
    </form>
    <div style="margin-top:20px">
      <div class="card-title">🏅 Bảng cấp độ</div>
      <%[{r:'1-9',e:'🔵',n:'Rookie'},{r:'10-19',e:'🟢',n:'Silver'},{r:'20-29',e:'⭐',n:'Gold'},{r:'30-39',e:'🔥',n:'Platinum'},{r:'40-49',e:'💎',n:'Diamond'},{r:'50',e:'👑',n:'Legend'}].forEach(lv=>{%>
      <div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--card-border);font-size:13px">
        <span><%=lv.e%></span><span style="color:var(--text2)">Lv.<%=lv.r%></span><b><%=lv.n%></b>
      </div>
      <%})%>
    </div>
  </div>
</div>
</div></div>
</body></html>
