<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Admin - 4ummo</title>
<%- include('partials/theme-head') %>
<link rel="stylesheet" href="/css/style.css?v=<%=assetVersion%>">
<link rel="stylesheet" href="/css/coins.css?v=<%=assetVersion%>">
<script src="/js/menu.js?v=<%=assetVersion%>" defer></script></head><body>
<%
const inp = 'padding:9px 12px;background:var(--fill);border:1px solid var(--card-border);border-radius:10px;color:var(--text);width:100%';
const sel = inp.replace('var(--fill)','var(--bg2)');
%>
<%- include('partials/sidebar',{page:'admin',user}) %>
<div class="main" id="main">
  <%- include('partials/topbar') %>
  <div class="topbar"><div class="topbar-title">⚙️ Admin Panel</div></div>
  <div class="page">
    <%if(error){%><div class="alert alert-error">⚠️ <%=error%></div><%}%>
    <%if(ok){%><div class="alert alert-success">✅ Thao tác thành công!</div><%}%>

    <div class="tabs">
      <button class="tab-btn active" onclick="showTab('tasks',this)">⚡ Nhiệm vụ</button>
      <button class="tab-btn" onclick="showTab('providers',this)">🔗 Nhà cung cấp</button>
      <button class="tab-btn" onclick="showTab('withdrawals',this)">💸 Rút tiền</button>
      <button class="tab-btn" onclick="showTab('buff',this)">🎁 Buff coin</button>
      <button class="tab-btn" onclick="showTab('shop',this)">🛍️ Sản phẩm</button>
      <button class="tab-btn" onclick="showTab('ranking',this)">🏆 Đua top</button>
      <button class="tab-btn" onclick="showTab('users',this)">👥 Users & IP</button>
      <button class="tab-btn" onclick="showTab('ipmonitor',this)">🕵️ Giám sát IP</button>
      <button class="tab-btn" onclick="showTab('security',this)">🛡️ Bảo mật</button>
      <button class="tab-btn" onclick="showTab('content',this)">📢 Nội dung</button>
      <button class="tab-btn" onclick="showTab('settings',this)">⚙️ Cài đặt</button>
    </div>

    <!-- TASKS -->
    <div class="tab-panel active" id="tab-tasks">
      <div class="card" style="margin-bottom:12px">
        <div class="card-title">📁 Danh mục nhiệm vụ</div>
        <form method="POST" action="/admin/categories" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
          <input name="name" placeholder="Tên danh mục" style="flex:1;min-width:140px;<%=inp%>" required>
          <input name="icon" placeholder="Icon" style="width:70px;<%=inp%>" value="⚡">
          <input name="sort_order" type="number" placeholder="Thứ tự" style="width:80px;<%=inp%>" value="0">
          <button class="btn btn-success btn-sm" type="submit">+ Thêm</button>
        </form>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          <%categories.forEach(c=>{%>
          <div style="display:flex;align-items:center;gap:6px;background:var(--fill);border:1px solid var(--card-border);border-radius:8px;padding:6px 10px">
            <span><%=c.icon%> <%=c.name%></span>
            <form method="POST" action="/admin/categories/<%=c.id%>/toggle" style="display:inline">
              <button class="btn btn-sm <%=c.active?'btn-warning':'btn-success'%>" type="submit" style="padding:2px 8px;font-size:11px"><%=c.active?'Tắt':'Bật'%></button>
            </form>
            <form method="POST" action="/admin/categories/<%=c.id%>/delete" onsubmit="return confirm('Xóa danh mục?')" style="display:inline">
              <button class="btn btn-sm btn-danger" type="submit" style="padding:2px 8px;font-size:11px">Xóa</button>
            </form>
          </div>
          <%})%>
        </div>
      </div>

      <div class="card" style="margin-bottom:12px">
        <div class="card-title">➕ Thêm nhiệm vụ</div>
        <form method="POST" action="/admin/tasks" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px">
          <input name="name" placeholder="Tên nhiệm vụ" style="<%=inp%>" required>
          <select name="category_id" style="<%=sel%>">
            <option value="">-- Không có danh mục --</option>
            <%categories.filter(c=>c.active).forEach(c=>{%><option value="<%=c.id%>"><%=c.icon%> <%=c.name%></option><%})%>
          </select>
          <select name="provider" style="<%=sel%>">
            <%providers.filter(p=>p.active).forEach(p=>{%><option value="<%=p.name%>"><%=p.name%></option><%})%>
          </select>
          <input name="target_url" placeholder="URL đích (để trống = tự về trang nhiệm vụ)" style="<%=inp%>">
          <input name="base_reward" type="number" placeholder="Thưởng Ncoin" style="<%=inp%>" required>
          <input name="exp_reward" type="number" placeholder="EXP" value="1" style="<%=inp%>">
          <input name="min_seconds" type="number" placeholder="Giây tối thiểu" value="30" style="<%=inp%>">
          <input name="daily_limit" type="number" placeholder="Lượt/user/(chu kỳ)" value="2" style="<%=inp%>">
          <input name="ip_daily_limit" type="number" placeholder="Lượt/IP/(chu kỳ)" value="2" style="<%=inp%>">
          <select name="reset_mode" style="<%=sel%>">
            <option value="daily">Reset cố định 00:00</option>
            <option value="rolling">Reset theo giờ (từ lần vượt gần nhất)</option>
          </select>
          <input name="reset_hours" type="number" placeholder="Số giờ (nếu chọn rolling)" value="24" style="<%=inp%>">
          <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text2);grid-column:1/-1">
            <input type="checkbox" name="require_review" style="width:auto"> Nhà cung cấp này yêu cầu IP chất lượng - luôn đưa vào "chờ duyệt" để tự kiểm tra tay, không cộng thưởng tự động
          </label>
          <button class="btn btn-primary" type="submit" style="grid-column:1/-1">➕ Thêm nhiệm vụ</button>
        </form>
      </div>

      <div class="card">
        <div class="card-title">📋 Danh sách nhiệm vụ</div>
        <table>
          <tr><th>Tên</th><th>Danh mục</th><th>NCC</th><th>Thưởng</th><th>Lượt</th><th>IP</th><th>Reset</th><th>Duyệt tay</th><th>Trạng thái</th><th></th></tr>
          <%tasks.forEach(t=>{%>
          <tr>
            <td><%=t.name%></td>
            <td style="color:var(--text2)"><%=t.cat_name||'—'%></td>
            <td><span style="background:rgba(16,185,129,0.15);color:var(--ok);padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600"><%=t.provider%></span></td>
            <td><span class="coin-wrap"><span class="ni sm">N</span><%=t.base_reward.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></span></td>
            <td><%=t.daily_limit%></td><td><%=t.ip_daily_limit%></td>
            <td style="font-size:11px;color:var(--text2)"><%=t.reset_mode==='rolling'?`${t.reset_hours}h/lần`:'00:00'%></td>
            <td>
              <form method="POST" action="/admin/tasks/<%=t.id%>/toggle-review">
                <button class="btn btn-sm" type="submit" style="<%=t.require_review?'background:rgba(168,85,247,0.15);color:var(--violet)':'background:rgba(156,163,175,0.1);color:var(--gray)'%>"><%=t.require_review?'📶 Bật':'Tắt'%></button>
              </form>
            </td>
            <td><%if(t.active){%><span class="badge badge-success">Bật</span><%}else{%><span class="badge badge-danger">Tắt</span><%}%></td>
            <td style="display:flex;gap:4px;flex-wrap:wrap">
              <button class="btn btn-sm btn-outline" type="button" onclick="document.getElementById('edit-task-<%=t.id%>').style.display=document.getElementById('edit-task-<%=t.id%>').style.display==='none'?'table-row':'none'">✏️ Sửa</button>
              <form method="POST" action="/admin/tasks/<%=t.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=t.active?'Tắt':'Bật'%></button></form>
              <form method="POST" action="/admin/tasks/<%=t.id%>/delete" onsubmit="return confirm('Xóa nhiệm vụ? Lịch sử cũng bị xóa.')"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <tr id="edit-task-<%=t.id%>" style="display:none">
            <td colspan="10" style="background:var(--row-bg)">
              <form method="POST" action="/admin/tasks/<%=t.id%>/edit" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;padding:10px 0">
                <input name="name" placeholder="Tên nhiệm vụ" value="<%=t.name%>" style="<%=inp%>" required>
                <select name="category_id" style="<%=sel%>">
                  <option value="">-- Không có danh mục --</option>
                  <%categories.forEach(c=>{%><option value="<%=c.id%>" <%=String(t.category_id)===String(c.id)?'selected':''%>><%=c.icon%> <%=c.name%></option><%})%>
                </select>
                <select name="provider" style="<%=sel%>">
                  <%providers.forEach(p=>{%><option value="<%=p.name%>" <%=t.provider===p.name?'selected':''%>><%=p.name%></option><%})%>
                </select>
                <input name="target_url" placeholder="URL đích" value="<%=t.target_url%>" style="<%=inp%>">
                <input name="base_reward" type="number" placeholder="Thưởng Ncoin" value="<%=t.base_reward%>" style="<%=inp%>" required>
                <input name="exp_reward" type="number" placeholder="EXP" value="<%=t.exp_reward%>" style="<%=inp%>">
                <input name="min_seconds" type="number" placeholder="Giây tối thiểu" value="<%=t.min_seconds%>" style="<%=inp%>">
                <input name="daily_limit" type="number" placeholder="Lượt/user/(chu kỳ)" value="<%=t.daily_limit%>" style="<%=inp%>">
                <input name="ip_daily_limit" type="number" placeholder="Lượt/IP/(chu kỳ)" value="<%=t.ip_daily_limit%>" style="<%=inp%>">
                <select name="reset_mode" style="<%=sel%>">
                  <option value="daily" <%=t.reset_mode==='daily'?'selected':''%>>Reset cố định 00:00</option>
                  <option value="rolling" <%=t.reset_mode==='rolling'?'selected':''%>>Reset theo giờ (từ lần vượt gần nhất)</option>
                </select>
                <input name="reset_hours" type="number" placeholder="Số giờ (nếu chọn rolling)" value="<%=t.reset_hours%>" style="<%=inp%>">
                <select name="active" style="<%=sel%>">
                  <option value="on" <%=t.active?'selected':''%>>🟢 Bật (đang hoạt động)</option>
                  <option value="off" <%=!t.active?'selected':''%>>🔴 Tắt</option>
                </select>
                <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text2);grid-column:1/-1">
                  <input type="checkbox" name="require_review" <%=t.require_review?'checked':''%> style="width:auto"> Nhà cung cấp này yêu cầu IP chất lượng - luôn đưa vào "chờ duyệt"
                </label>
                <div style="grid-column:1/-1;display:flex;gap:8px">
                  <button class="btn btn-primary" type="submit">💾 Lưu thay đổi</button>
                  <button class="btn btn-outline" type="button" onclick="document.getElementById('edit-task-<%=t.id%>').style.display='none'">Hủy</button>
                </div>
              </form>
            </td>
          </tr>
          <%})%>
        </table>
      </div>
    </div>

    <!-- PROVIDERS -->
    <div class="tab-panel" id="tab-providers">
      <div class="card" style="margin-bottom:12px">
        <div class="card-title">➕ Thêm nhà cung cấp mới</div>
        <form method="POST" action="/admin/providers/add" style="display:flex;gap:8px;flex-wrap:wrap">
          <input name="name" placeholder="Tên (link4m, site2s...)" style="flex:1;min-width:120px;<%=inp%>" required>
          <input name="api_key" placeholder="API Key" style="flex:2;min-width:200px;<%=inp%>">
          <input name="api_endpoint" placeholder="Endpoint URL" style="flex:2;min-width:200px;<%=inp%>">
          <button class="btn btn-primary" type="submit">+ Thêm</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">🔗 Nhà cung cấp link rút gọn</div>
        <%providers.forEach(p=>{%>
        <div style="padding:14px;border-bottom:1px solid var(--card-border)">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
            <div style="display:flex;align-items:center;gap:8px">
              <span style="font-weight:600;font-size:15px"><%=p.name%></span>
              <%if(p.active){%><span class="badge badge-success">Active</span><%}else{%><span class="badge badge-danger">Tắt</span><%}%>
            </div>
            <div style="display:flex;gap:4px">
              <form method="POST" action="/admin/providers/<%=p.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=p.active?'Tắt':'Bật'%></button></form>
              <form method="POST" action="/admin/providers/<%=p.id%>/delete" onsubmit="return confirm('Xóa nhà cung cấp này? Chỉ xóa được nếu không còn nhiệm vụ nào đang dùng.')"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </div>
          </div>
          <form method="POST" action="/admin/providers" style="display:flex;gap:8px;flex-wrap:wrap">
            <input type="hidden" name="id" value="<%=p.id%>">
            <input name="api_key" placeholder="API Key" value="<%=p.api_key%>" style="flex:1;min-width:160px;<%=inp%>">
            <input name="api_endpoint" placeholder="Mẫu endpoint: https://domain.com/ql?token={API_KEY}&longurl={URL}" value="<%=p.api_endpoint||''%>" style="flex:2;min-width:220px;<%=inp%>">
            <button class="btn btn-success btn-sm" type="submit">💾 Lưu</button>
          </form>
          <div style="font-size:11px;color:var(--text2);margin-top:6px">Endpoint hiện tại: <%=p.api_endpoint||'Mặc định'%></div>
          <div style="font-size:11px;color:var(--text2);margin-top:2px">Dùng placeholder: <code>{API_KEY}</code> = API Key, <code>{URL}</code> = link đích (giữ nguyên), <code>{URL_B64}</code> = link đích (mã hóa base64, dùng cho link4m/site2s). Mỗi nhà cung cấp có thể đặt tên tham số khác nhau (api/token, url/longurl...) nên phải điền đúng theo tài liệu API của họ.</div>
        </div>
        <%})%>
      </div>
    </div>

    <!-- WITHDRAWALS -->
    <div class="tab-panel" id="tab-withdrawals">
      <div class="card">
        <div class="card-title">💸 Rút tiền chờ duyệt (<%=withdrawals.length%>)</div>
        <table>
          <tr><th>User</th><th>Rút</th><th>Phí (+)</th><th>Tổng trừ</th><th>PT</th><th>Thông tin</th><th>Ngày</th><th></th></tr>
          <%withdrawals.forEach(w=>{%>
          <tr>
            <td><b><%=w.username%></b></td>
            <td><span class="coin-wrap"><span class="ni sm">N</span><%=w.amount.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></span></td>
            <td style="color:var(--bad)">+<%=(w.fee||0).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td style="color:var(--ok);font-weight:600"><%=(w.amount+(w.fee||0)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%> coin</td>
            <td><%=w.method%></td>
            <td style="font-size:12px;color:var(--text2)">
              <%=w.detail%>
              <%if(w.dup_payment_count>0){%><div style="margin-top:4px"><span class="badge badge-danger">⚠️ Trùng thông tin nhận tiền với tài khoản khác</span></div><%}%>
            </td>
            <td style="font-size:12px;color:var(--text2)"><%=new Date(parseInt(w.created_at)).toLocaleDateString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td style="display:flex;gap:4px">
              <form method="POST" action="/admin/withdrawals/<%=w.id%>/approve"><button class="btn btn-sm btn-success" type="submit">✅</button></form>
              <form method="POST" action="/admin/withdrawals/<%=w.id%>/reject"><button class="btn btn-sm btn-danger" type="submit">❌</button></form>
            </td>
          </tr>
          <%})%>
        </table>
        <%if(withdrawals.length===0){%><div style="text-align:center;padding:20px;color:var(--text2)">Không có yêu cầu</div><%}%>
      </div>
    </div>

    <!-- BUFF -->
    <div class="tab-panel" id="tab-buff">
      <div class="card" style="margin-bottom:12px">
        <div class="card-title">🎁 Điều chỉnh coin (nhập số âm để trừ, ví dụ -5000)</div>
        <form method="POST" action="/admin/buff" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Chọn user</label>
          <input type="text" placeholder="🔍 Gõ để tìm theo tên (tìm trên toàn bộ user, không giới hạn 100)..." oninput="searchUserSelect(this,'buffSelect1')" style="width:100%;<%=inp%>;margin-bottom:6px">
          <select name="user_id" id="buffSelect1" style="width:100%;<%=sel%>">
            <%users.forEach(u=>{%><option value="<%=u.id%>"><%=u.username%> (<%=u.ncoin%>N/<%=u.vcoin%>V)</option><%})%>
          </select></div>
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px"><span class="ni sm">N</span> Ncoin (+/-)</label>
          <input name="ncoin_amount" type="number" placeholder="0" value="0" style="width:100%;<%=inp%>"></div>
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px"><span class="vi sm">V</span> Vcoin (+/-)</label>
          <input name="vcoin_amount" type="number" placeholder="0" value="0" style="width:100%;<%=inp%>"></div>
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Ghi chú</label>
          <input name="note" placeholder="Lý do..." style="width:100%;<%=inp%>"></div>
          <div style="align-self:end"><button class="btn btn-primary btn-full" type="submit">💾 Áp dụng</button></div>
        </form>
      </div>

      <div class="card" style="margin-bottom:12px">
        <div class="card-title">🏆 Buff bảng xếp hạng tuần (không ảnh hưởng ví Ncoin thật, chỉ đẩy thứ hạng)</div>
        <div class="alert alert-info" style="margin-bottom:12px">ℹ️ Dùng để test đua top khi web còn ít user — cộng thẳng vào số liệu tuần hiện tại, không cộng tiền vào ví.</div>
        <form method="POST" action="/admin/buff-ranking" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Chọn user</label>
          <input type="text" placeholder="🔍 Gõ để tìm theo tên (tìm trên toàn bộ user, không giới hạn 100)..." oninput="searchUserSelect(this,'buffSelect2')" style="width:100%;<%=inp%>;margin-bottom:6px">
          <select name="user_id" id="buffSelect2" style="width:100%;<%=sel%>">
            <%users.forEach(u=>{%><option value="<%=u.id%>"><%=u.username%></option><%})%>
          </select></div>
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Số lượt vượt cộng thêm</label>
          <input name="task_count_add" type="number" placeholder="0" value="0" style="width:100%;<%=inp%>"></div>
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Ncoin hiển thị trên BXH cộng thêm</label>
          <input name="ncoin_earned_add" type="number" placeholder="0" value="0" style="width:100%;<%=inp%>"></div>
          <div style="align-self:end"><button class="btn btn-primary btn-full" type="submit">🏆 Buff BXH</button></div>
        </form>
      </div>

      <div class="card">
        <div class="card-title">🎁 Buff bảng xếp hạng giới thiệu tháng (không ảnh hưởng ví Ncoin thật, chỉ đẩy thứ hạng)</div>
        <div class="alert alert-info" style="margin-bottom:12px">ℹ️ Tương tự buff BXH tuần ở trên, nhưng cho bảng xếp hạng giới thiệu bạn bè hàng tháng (trang /referral). Số coin hiển thị ở đây KHÔNG cộng vào ví - chỉ để hiển thị trên bảng xếp hạng.</div>
        <form method="POST" action="/admin/buff-referral" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Chọn user</label>
          <input type="text" placeholder="🔍 Gõ để tìm theo tên (tìm trên toàn bộ user, không giới hạn 100)..." oninput="searchUserSelect(this,'buffSelect3')" style="width:100%;<%=inp%>;margin-bottom:6px">
          <select name="user_id" id="buffSelect3" style="width:100%;<%=sel%>">
            <%users.forEach(u=>{%><option value="<%=u.id%>"><%=u.username%></option><%})%>
          </select></div>
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Số người giới thiệu cộng thêm</label>
          <input name="ref_count_add" type="number" placeholder="0" value="0" style="width:100%;<%=inp%>"></div>
          <div><label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">Ncoin hoa hồng hiển thị cộng thêm</label>
          <input name="commission_earned_add" type="number" placeholder="0" value="0" style="width:100%;<%=inp%>"></div>
          <div style="align-self:end"><button class="btn btn-primary btn-full" type="submit">🎁 Buff BXH giới thiệu</button></div>
        </form>
      </div>
    </div>

<!-- SHOP -->
    <div class="tab-panel" id="tab-shop">

      <div class="card" style="margin-bottom:12px">
        <div class="card-title">🗂️ Danh mục sản phẩm</div>
        <form method="POST" action="/admin/shop-categories" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
          <input name="name" placeholder="Tên danh mục (VD: Gmail)" style="<%=inp%>" required>
          <input name="icon" placeholder="Icon (VD: 📧)" style="<%=inp%>;width:90px">
          <input name="sort_order" type="number" placeholder="Thứ tự" value="0" style="<%=inp%>;width:90px">
          <button class="btn btn-primary btn-sm" type="submit">➕ Thêm danh mục</button>
        </form>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          <%shopCategories.forEach(c=>{%>
          <div style="display:flex;align-items:center;gap:6px;padding:6px 10px;border:1px solid var(--card-border);border-radius:20px;<%=c.active?'':'opacity:0.5'%>">
            <span><%=c.icon%> <%=c.name%></span>
            <form method="POST" action="/admin/shop-categories/<%=c.id%>/toggle"><button class="btn btn-sm btn-warning" style="padding:2px 8px" type="submit"><%=c.active?'Tắt':'Bật'%></button></form>
            <form method="POST" action="/admin/shop-categories/<%=c.id%>/delete" onsubmit="return confirm('Xóa danh mục? Sản phẩm trong danh mục sẽ chuyển về không danh mục.')"><button class="btn btn-sm btn-danger" style="padding:2px 8px" type="submit">Xóa</button></form>
          </div>
          <%})%>
          <%if(shopCategories.length===0){%><div style="color:var(--text2);font-size:13px">Chưa có danh mục nào.</div><%}%>
        </div>
      </div>

      <div class="card" style="margin-bottom:12px">
        <div class="card-title">➕ Thêm sản phẩm</div>
        <form method="POST" action="/admin/products" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px">
          <input name="name" placeholder="Tên sản phẩm" style="<%=inp%>" required>
          <input name="description" placeholder="Mô tả" style="<%=inp%>">
          <select name="category_id" style="<%=sel%>">
            <option value="">-- Không danh mục --</option>
            <%shopCategories.forEach(c=>{%><option value="<%=c.id%>"><%=c.icon%> <%=c.name%></option><%})%>
          </select>
          <input name="price" type="number" placeholder="Giá (coin)" value="0" style="<%=inp%>">
          <select name="delivery_mode" style="<%=sel%>">
            <option value="manual">Giao thủ công (admin gửi tay)</option>
            <option value="pool">Giao tự động (từ kho có sẵn)</option>
          </select>
          <input name="stock" type="number" placeholder="Kho (chỉ dùng nếu giao thủ công, -1=∞)" value="-1" style="<%=inp%>">
          <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text2);grid-column:1/-1">
            <input type="checkbox" name="require_note" style="width:auto"> Bắt khách nhập thông tin trước khi đặt (VD: username Roblox)
          </label>
          <input name="note_label" placeholder="Hỏi khách nhập gì? (VD: Nhập username Roblox của bạn)" style="<%=inp%>;grid-column:1/-1">
          <button class="btn btn-primary" type="submit" style="grid-column:1/-1">➕ Thêm sản phẩm</button>
        </form>
        <div style="font-size:11px;color:var(--text2);margin-top:8px">💡 "Giao tự động": sau khi tạo sản phẩm, cuộn xuống bảng bên dưới để dán danh sách tài khoản/thông tin vào kho (mỗi dòng 1 món hàng) - hệ thống sẽ tự động giao 1 dòng cho khách ngay khi họ mua.</div>
      </div>

      <div class="card" style="margin-bottom:12px">
        <div class="card-title">📦 Đơn hàng sản phẩm chờ xử lý (<%=orders.length%>)</div>
        <%orders.forEach(o=>{%>
        <div style="padding:12px;border:1px solid var(--card-border);border-radius:10px;margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">
            <div>
              <div><b><%=o.username%></b> mua <b><%=o.pname%></b> x<%=o.quantity||1%> <span style="font-size:11px;color:var(--text2)">(mã <%=o.order_code%>)</span></div>
              <div style="font-size:12px;color:var(--text2)"><%=new Date(parseInt(o.created_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></div>
              <%if(o.note){%><div style="font-size:12.5px;margin-top:4px;padding:6px 10px;background:rgba(96,165,250,0.1);border:1px solid rgba(96,165,250,0.2);border-radius:8px;color:var(--info-text)">📝 Khách nhập: <b><%=o.note%></b></div><%}%>
            </div>
            <div><%if(o.price_ncoin>0){%><span class="coin-wrap"><span class="ni sm">N</span><%=o.price_ncoin.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></span><%}%><%if(o.price_vcoin>0){%><span class="coin-wrap"><span class="vi sm">V</span><%=o.price_vcoin.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></span><%}%></div>
          </div>
          <form method="POST" action="/admin/orders/<%=o.id%>/done" style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">
            <textarea name="delivery_info" placeholder="Dán tài khoản/mật khẩu hoặc thông tin giao cho khách..." rows="2" style="flex:1;min-width:220px;padding:8px 10px;background:var(--fill);border:1px solid var(--card-border);border-radius:8px;color:var(--text);resize:vertical"></textarea>
            <div style="display:flex;flex-direction:column;gap:6px">
              <button class="btn btn-sm btn-success" type="submit">✅ Gửi & Hoàn tất</button>
            </div>
          </form>
          <form method="POST" action="/admin/orders/<%=o.id%>/reject" style="margin-top:6px"><button class="btn btn-sm btn-danger" type="submit">❌ Hủy & hoàn tiền</button></form>
        </div>
        <%})%>
        <%if(orders.length===0){%><div style="text-align:center;padding:14px;color:var(--text2)">Không có đơn hàng chờ</div><%}%>
      </div>

      <div class="card">
        <div class="card-title">📋 Danh sách sản phẩm</div>
        <table>
          <tr><th>Tên</th><th>Danh mục</th><th>Kiểu giao</th><th>Giá</th><th>Kho</th><th>Yêu cầu nhập</th><th>Trạng thái</th><th></th></tr>
          <%products.forEach(p=>{%>
          <tr>
            <td><%=p.name%></td>
            <td style="color:var(--text2)"><%=p.cat_name||'—'%></td>
            <td><%if(p.delivery_mode==='pool'){%><span class="badge" style="background:rgba(16,185,129,0.15);color:var(--ok)">Tự động</span><%}else{%><span class="badge" style="background:rgba(156,163,175,0.15);color:var(--gray)">Thủ công</span><%}%></td>
            <td><span class="coin-wrap"><%=(p.price||0).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%> coin</span></td>
            <td><%if(p.delivery_mode==='pool'){%><%=p.pool_available%> sẵn có<%}else{%><%=p.stock===-1?'∞':p.stock%><%}%></td>
            <td style="font-size:11px">
              <%if(p.require_note){%><span class="badge" style="background:rgba(168,85,247,0.15);color:var(--violet)">📝 <%=p.note_label||'Có'%></span><%}else{%><span style="color:var(--text2)">Không</span><%}%>
            </td>
            <td><%if(p.active){%><span class="badge badge-success">Bật</span><%}else{%><span class="badge badge-danger">Tắt</span><%}%></td>
            <td style="display:flex;gap:4px;flex-wrap:wrap">
              <button class="btn btn-sm btn-outline" type="button" onclick="document.getElementById('edit-prod-<%=p.id%>').style.display=document.getElementById('edit-prod-<%=p.id%>').style.display==='none'?'table-row':'none'">✏️ Sửa</button>
              <form method="POST" action="/admin/products/<%=p.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=p.active?'Tắt':'Bật'%></button></form>
              <form method="POST" action="/admin/products/<%=p.id%>/delete" onsubmit="return confirm('Xóa hẳn sản phẩm này? Lịch sử đơn hàng cũ vẫn được giữ (tên sản phẩm vẫn hiện đúng), chỉ không xóa được nếu còn đơn đang \'chờ xử lý\'.')"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <tr id="edit-prod-<%=p.id%>" style="display:none">
            <td colspan="8" style="background:var(--row-bg)">
              <form method="POST" action="/admin/products/<%=p.id%>/edit" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;padding:10px 0">
                <input name="name" placeholder="Tên sản phẩm" value="<%=p.name%>" style="<%=inp%>" required>
                <input name="description" placeholder="Mô tả" value="<%=p.description%>" style="<%=inp%>">
                <select name="category_id" style="<%=sel%>">
                  <option value="">-- Không danh mục --</option>
                  <%shopCategories.forEach(c=>{%><option value="<%=c.id%>" <%=String(p.category_id)===String(c.id)?'selected':''%>><%=c.icon%> <%=c.name%></option><%})%>
                </select>
                <input name="price" type="number" placeholder="Giá (coin)" value="<%=p.price%>" style="<%=inp%>">
                <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text2);grid-column:1/-1">
                  <input type="checkbox" name="require_note" <%=p.require_note?'checked':''%> style="width:auto"> Bắt khách nhập thông tin trước khi đặt
                </label>
                <input name="note_label" placeholder="Hỏi khách nhập gì? (VD: Nhập username Roblox của bạn)" value="<%=p.note_label||''%>" style="<%=inp%>;grid-column:1/-1">
                <div style="grid-column:1/-1;display:flex;gap:8px">
                  <button class="btn btn-primary" type="submit">💾 Lưu thay đổi</button>
                  <button class="btn btn-outline" type="button" onclick="document.getElementById('edit-prod-<%=p.id%>').style.display='none'">Hủy</button>
                </div>
              </form>
            </td>
          </tr>
          <%if(p.delivery_mode==='pool'){%>
          <tr><td colspan="8" style="background:var(--row-bg)">
            <form method="POST" action="/admin/products/<%=p.id%>/stock" style="display:flex;gap:6px;flex-wrap:wrap;padding:6px 0">
              <textarea name="items" placeholder="Dán danh sách, mỗi dòng 1 tài khoản (VD: user1@gmail.com|matkhau123)" rows="2" style="flex:1;min-width:220px;padding:8px 10px;background:var(--fill);border:1px solid var(--card-border);border-radius:8px;color:var(--text);resize:vertical"></textarea>
              <button class="btn btn-sm btn-success" type="submit">➕ Thêm vào kho</button>
            </form>
          </td></tr>
          <%}else{%>
          <!-- VA LOI DA SUA (2026-09): route /admin/products/:id/restock da co san
               o backend nhung TRUOC DAY KHONG CO form/nut nao goi toi no ca - nghia
               la san pham "giao thu cong" chi dat duoc so luong kho 1 LAN DUY NHAT
               luc tao, het hang la KHONG CO CACH NAO cap nhat lai qua giao dien. -->
          <tr><td colspan="8" style="background:var(--row-bg)">
            <form method="POST" action="/admin/products/<%=p.id%>/restock" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;padding:6px 0">
              <span style="font-size:12px;color:var(--text2)">Cập nhật số lượng kho (-1 = không giới hạn):</span>
              <input name="stock" type="number" placeholder="Số lượng mới" value="<%=p.stock%>" style="width:120px;padding:6px 8px;background:var(--fill);border:1px solid var(--card-border);border-radius:8px;color:var(--text)">
              <button class="btn btn-sm btn-success" type="submit">💾 Cập nhật kho</button>
            </form>
          </td></tr>
          <%}%>
          <%})%>
        </table>
      </div>
    </div>


    <!-- RANKING -->
    <div class="tab-panel" id="tab-ranking">
      <div class="card">
        <div class="card-title">🏆 Cài đặt đua top</div>
        <form method="POST" action="/admin/settings">
          <div class="fg"><label>Phần thưởng hạng 1 (đ)</label><input name="weekly_reward_1" type="number" value="<%=settings.weekly_reward_1||50000%>"></div>
          <div class="fg"><label>Phần thưởng hạng 2 (đ)</label><input name="weekly_reward_2" type="number" value="<%=settings.weekly_reward_2||30000%>"></div>
          <div class="fg"><label>Phần thưởng hạng 3 (đ)</label><input name="weekly_reward_3" type="number" value="<%=settings.weekly_reward_3||20000%>"></div>
          <div class="fg"><label>Bật/tắt đua top (BXH tuần nhiệm vụ)</label>
            <select name="ranking_enabled">
              <option value="1" <%=settings.ranking_enabled==='1'?'selected':''%>>Bật</option>
              <option value="0" <%=settings.ranking_enabled!=='1'?'selected':''%>>Tắt</option>
            </select>
            <div style="font-size:11px;color:var(--text2);margin-top:4px">Tắt: ẩn trang BXH tuần và KHÔNG tự động trao thưởng Top 1/2/3 cho tuần đó nữa (không dồn thưởng khi bật lại).</div>
          </div>
          <button class="btn btn-primary" type="submit">💾 Lưu</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">🤝 Cài đặt giới thiệu bạn bè</div>
        <form method="POST" action="/admin/settings">
          <div class="fg"><label>Bật/tắt hoa hồng giới thiệu (toàn bộ %)</label>
            <select name="referral_enabled">
              <option value="1" <%=settings.referral_enabled!=='0'?'selected':''%>>Bật</option>
              <option value="0" <%=settings.referral_enabled==='0'?'selected':''%>>Tắt</option>
            </select>
            <div style="font-size:11px;color:var(--text2);margin-top:4px">Tắt: dừng cộng hoa hồng % cho người giới thiệu ở mọi bậc.</div>
          </div>
          <div class="fg"><label>Bật/tắt bảng xếp hạng giới thiệu tháng</label>
            <select name="referral_ranking_enabled">
              <option value="1" <%=settings.referral_ranking_enabled!=='0'?'selected':''%>>Bật</option>
              <option value="0" <%=settings.referral_ranking_enabled==='0'?'selected':''%>>Tắt</option>
            </select>
            <div style="font-size:11px;color:var(--text2);margin-top:4px">Tắt riêng mục này: toàn bộ khối "Đua Top giới thiệu" biến mất hẳn khỏi trang /referral (không chỉ ẩn số liệu) + ngừng thưởng Top 1/2/3 hàng tháng, nhưng hoa hồng % (mục trên) vẫn chạy bình thường nếu đang bật. Không dồn thưởng khi bật lại.</div>
          </div>
          <!-- VA LOI DA SUA (2026-09, "chua co cho set thuong BXH gioi thieu"):
               truoc day cac cot settings referral_reward_1/2/3 DA TON TAI va
               DA DUOC lib/referral.js + lib/rewardCron.js doc/dung khi trao
               thuong Top 1/2/3 hang thang - nhung KHONG CO O NAO tren giao
               dien admin de nhap gia tri, nen mac dinh luon la 0 (khong bao
               gio trao duoc gi du BXH dang bat). Them 3 o nhap con thieu. -->
          <div class="fg"><label>Thưởng Top 1 giới thiệu/tháng (đ)</label><input name="referral_reward_1" type="number" value="<%=settings.referral_reward_1||0%>"></div>
          <div class="fg"><label>Thưởng Top 2 giới thiệu/tháng (đ)</label><input name="referral_reward_2" type="number" value="<%=settings.referral_reward_2||0%>"></div>
          <div class="fg"><label>Thưởng Top 3 giới thiệu/tháng (đ)</label><input name="referral_reward_3" type="number" value="<%=settings.referral_reward_3||0%>"></div>
          <button class="btn btn-primary" type="submit">💾 Lưu</button>
        </form>
      </div>
    </div>

    <!-- USERS -->
    <div class="tab-panel" id="tab-users">
      <div class="card" style="margin-bottom:12px;border-color:rgba(239,68,68,0.3)">
        <div class="card-title">⚠️ Reset dữ liệu IP/Thiết bị</div>
        <div style="font-size:13px;color:var(--text2);margin-bottom:10px">
          Nếu tài khoản thật bị chặn nhầm "trùng IP/thiết bị" do dữ liệu test cũ (nhiều tài khoản test dùng chung máy/mạng lúc phát triển),
          bấm nút này để xóa sạch lịch sử IP/fingerprint đã ghi nhận — không ảnh hưởng số dư, chỉ xóa dữ liệu chống gian lận để bắt đầu lại từ đầu.
        </div>
        <form method="POST" action="/admin/reset-ip-data" onsubmit="return confirm('Xóa toàn bộ dữ liệu IP/thiết bị đã ghi nhận? Không thể hoàn tác.')">
          <button class="btn btn-danger" type="submit">🗑️ Xóa toàn bộ dữ liệu IP/Thiết bị</button>
        </form>
      </div>
      <div class="card" style="margin-bottom:12px">
        <div class="card-title">➕ Tạo tài khoản thủ công (để test)</div>
        <form method="POST" action="/admin/users/create" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px">
          <input name="username" placeholder="Tên đăng nhập" style="<%=inp%>" required>
          <input name="password" placeholder="Mật khẩu (≥6 ký tự)" style="<%=inp%>" required>
          <input name="ncoin" type="number" placeholder="Ncoin ban đầu" value="0" style="<%=inp%>">
          <input name="vcoin" type="number" placeholder="Vcoin ban đầu" value="0" style="<%=inp%>">
          <button class="btn btn-primary" type="submit">➕ Tạo</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">👥 Danh sách users</div>
        <table>
          <tr><th>ID</th><th>Username</th><th>Ncoin</th><th>Vcoin</th><th>Level</th><th>IP đăng ký</th><th>Trạng thái</th><th></th></tr>
          <%users.forEach(u=>{%>
          <tr>
            <td style="color:var(--text2)"><%=u.id%></td>
            <td><b><%=u.username%></b></td>
            <td><span class="coin-wrap"><span class="ni sm">N</span><%=u.ncoin.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></span></td>
            <td><span class="coin-wrap"><span class="vi sm">V</span><%=u.vcoin.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></span></td>
            <td>Lv.<%=u.level%></td>
            <td><span class="ip-badge"><%=u.reg_ip||'—'%></span></td>
            <td><%if(u.is_banned){%><span class="badge badge-danger">🔒 Đã khóa</span><%}else{%><span class="badge badge-success">✅ Hoạt động</span><%}%></td>
            <td style="display:flex;gap:4px;flex-wrap:wrap">
              <a href="/admin/user/<%=u.id%>/ips" class="btn btn-sm btn-outline">🔍 IP</a>
              <form method="POST" action="/admin/user/<%=u.id%>/reset-ip" onsubmit="return confirm('Xóa IP/thiết bị đã ghi nhận của user này? Dùng khi họ đổi máy/mạng bị chặn nhầm.')"><button class="btn btn-sm btn-outline" type="submit" style="color:var(--warn);border-color:rgba(245,158,11,0.3)">♻️ Reset IP</button></form>
              <form method="POST" action="/admin/users/<%=u.id%>/ban"><button class="btn btn-sm <%=u.is_banned?'btn-success':'btn-warning'%>" type="submit"><%=u.is_banned?'Mở khóa':'Khóa'%></button></form>
              <form method="POST" action="/admin/users/<%=u.id%>/delete" onsubmit="return confirm('Xóa vĩnh viễn tài khoản này? Toàn bộ dữ liệu liên quan sẽ mất.')"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <%})%>
        </table>
      </div>
    </div>

    <!-- IP MONITOR -->
    <div class="tab-panel" id="tab-ipmonitor">
      <div class="alert alert-info" style="margin-bottom:12px">ℹ️ Danh sách 100 lượt vượt link gần nhất kèm IP thật của user. Cột "Cảnh báo" đỏ nghĩa là IP này còn được dùng bởi tài khoản khác — dấu hiệu 1 người dùng nhiều tài khoản. IP chính (badge) do Cloudflare xác thực, luôn đáng tin. Dòng "IPv4 (tự báo cáo)" bên dưới là IPv4 do chính trình duyệt người dùng tự gửi lên (hữu ích khi IP chính là IPv6 dài khó đọc) — chỉ để tham khảo, không dùng để chặn vì có thể bị giả mạo.</div>
      <div class="card">
        <div class="card-title">🕵️ Nhật ký IP vượt link (100 lượt gần nhất)</div>
        <table>
          <tr><th>Thời gian</th><th>User</th><th>Nhiệm vụ</th><th>NCC</th><th>IP</th><th>VPN/Proxy/Mobile</th><th>Trạng thái</th><th>Cảnh báo</th></tr>
          <%ipMonitor.forEach(row=>{%>
          <tr>
            <td style="color:var(--text2);font-size:11px"><%=new Date(parseInt(row.created_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td><b><%=row.username%></b></td>
            <td style="font-size:12px"><%=row.task_name%></td>
            <td><span style="background:rgba(16,185,129,0.15);color:var(--ok);padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600"><%=row.task_provider%></span></td>
            <td>
              <span class="ip-badge"><%=row.ip_created||'—'%></span>
              <%if(row.ip_v4_hint){%><div style="margin-top:3px;font-size:11px;color:var(--text2)" title="IPv4 do trình duyệt người dùng tự báo cáo qua api4.ipify.org - KHÔNG được Cloudflare xác thực, chỉ mang tính tham khảo, có thể bị giả mạo">IPv4: <%=row.ip_v4_hint%> <span style="opacity:.6">(tự báo cáo)</span></div><%}%>
            </td>
            <td style="font-size:11px">
              <%if(row.ip_is_vpn===1){%><span class="badge badge-danger">🛡️ VPN/Proxy</span><%}%>
              <%if(row.ip_is_mobile===1){%><span class="badge" style="background:rgba(251,146,60,0.15);color:var(--orange);margin-left:4px">📱 4G/3G</span><%}%>
              <%if(row.ip_is_vpn!==1&&row.ip_is_mobile!==1){%><span style="color:var(--text2)"><%=row.ip_isp?row.ip_isp:(row.status==='pending'?'chưa xác nhận':'—')%></span><%}%>
            </td>
            <td>
              <%if(row.status==='completed'){%><span class="badge badge-success">Hoàn thành</span>
              <%}else if(row.status==='expired'){%><span class="badge">Hết hạn</span>
              <%}else if(row.status==='cho_duyet'){%><span class="badge badge-warning">⏳ Chờ duyệt</span>
              <%}else if(row.status==='rejected'){%><span class="badge badge-danger">❌ Từ chối</span>
              <%}else{%><span class="badge badge-warning">Đang chờ</span><%}%>
            </td>
            <td>
              <%if(parseInt(row.other_accounts)>0){%>
              <span class="badge badge-danger">⚠️ <%=row.other_accounts%> tk trùng IP</span>
              <%}%>
              <%if(parseInt(row.other_accounts_fp)>0){%>
              <span class="badge badge-danger" style="margin-left:4px">📱 <%=row.other_accounts_fp%> tk trùng máy</span>
              <%}%>
              <%if(parseInt(row.other_accounts)===0 && parseInt(row.other_accounts_fp)===0){%>
              <span style="color:var(--text2);font-size:11px">—</span>
              <%}%>
            </td>
          </tr>
          <%})%>
        </table>
        <%if(ipMonitor.length===0){%><div style="text-align:center;padding:20px;color:var(--text2)">Chưa có dữ liệu</div><%}%>
      </div>
    </div>

    <!-- BAO MAT -->
    <div class="tab-panel" id="tab-security">
      <div class="alert alert-info" style="margin-bottom:12px">ℹ️ Cầu dao tạm dừng xác nhận nhiệm vụ khi Ncoin/giờ tăng đột biến, và tự động đưa nhiệm vụ của tài khoản nghi ngờ farm vào hàng chờ duyệt — không tự khóa/chặn ai, admin luôn là người quyết định cuối cùng ở đây.</div>

      <div class="card" style="margin-bottom:16px">
        <div class="card-title">🔎 Chẩn đoán IP thật của server</div>
        <div style="font-size:12.5px;color:var(--text2);margin-bottom:8px">Nếu IP hiển thị (VD ở trang Nhiệm vụ) không phải IP thật của người dùng — kể cả khi đã bật <code>TRUST_CF_HEADER</code> + <code>CANONICAL_HOST</code> — nguyên nhân thường KHÔNG phải do "Cloudflare + Railway cộng lại" mà do <b>ai đó gọi thẳng vào domain gốc trên Railway (bỏ qua Cloudflare) và tự đặt IP giả</b> qua header. <code>CANONICAL_HOST</code> chỉ kiểm tra header "Host" — thứ mà chính kẻ giả mạo cũng tự khai báo được (vd bằng curl), nên KHÔNG đủ để chặn việc này.</div>
        <table>
          <tr><th>Mục</th><th>Giá trị</th></tr>
          <tr><td>IP server đang dùng (getClientIp)</td><td><span class="ip-badge"><%=ipDiag.used%></span></td></tr>
          <tr><td>Header <code>cf-connecting-ip</code> (Cloudflare gửi)</td><td><%=ipDiag.cfHeader||'— (không có)'%></td></tr>
          <tr><td>Header <code>x-forwarded-for</code></td><td><%=ipDiag.xff||'— (không có)'%></td></tr>
          <tr><td>req.ip (Express, sau trust proxy)</td><td><%=ipDiag.reqIp%></td></tr>
          <tr><td>Env TRUST_CF_HEADER</td><td><%if(ipDiag.trustCf){%><span class="badge badge-success">Đã bật</span><%}else{%><span class="badge badge-danger">CHƯA bật</span><%}%></td></tr>
          <tr><td>Env CANONICAL_HOST</td><td><%if(ipDiag.canonicalHost){%><span class="badge badge-success"><%=ipDiag.canonicalHost%></span><%}else{%><span class="badge badge-danger">CHƯA đặt</span><%}%></td></tr>
          <tr><td><b>Env CF_ORIGIN_SECRET</b> (lớp bảo vệ THẬT SỰ)</td><td><%if(ipDiag.cfOriginSecretConfigured){%><span class="badge badge-success">Đã bật</span><%}else{%><span class="badge badge-danger">⚠️ CHƯA bật — đây là lý do IP có thể sai/giả mạo được</span><%}%></td></tr>
          <%if(ipDiag.cfOriginSecretConfigured){%>
          <tr><td>Request tải trang admin này có đi qua Cloudflare thật không</td><td><%if(ipDiag.originSecretSeenOnThisRequest){%><span class="badge badge-success">✅ Có — cấu hình đang hoạt động đúng</span><%}else{%><span class="badge badge-danger">❌ Không thấy header bí mật — kiểm tra lại Transform Rule trên Cloudflare</span><%}%></td></tr>
          <%}%>
        </table>

        <%if(!ipDiag.cfOriginSecretConfigured){%>
        <div class="alert" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:var(--err-text);margin-top:10px">
          🚨 <b>Hiện tại IP hiển thị KHÔNG đáng tin</b> — ai đó có thể vào thẳng domain gốc Railway (không qua Cloudflare) và tự đặt IP bất kỳ (kể cả IP nước ngoài lạ như bạn đang thấy). Hệ thống đang tự động bỏ qua header Cloudflare cho tới khi bạn hoàn tất bước dưới đây, để không hiển thị số liệu có thể bị giả mạo.
        </div>
        <div style="margin-top:10px;font-size:13px">
          <b>Làm theo đúng 3 bước sau (thiếu bước nào cũng không an toàn):</b>
          <ol style="margin:8px 0 0 18px;padding:0;color:var(--text2);line-height:1.9">
            <li>Vào <b>Cloudflare Dashboard</b> → chọn tên miền của bạn → <b>Rules</b> → <b>Transform Rules</b> → <b>Create rule</b> → <b>Modify Request Header</b>.
              <br>Đặt: When incoming requests match... <code>All incoming requests</code>. Then: <code>Set static</code>, header name <code>X-Origin-Secret</code>, value dán đúng chuỗi bên dưới. Lưu lại.</li>
            <li>Vào <b>Railway</b> → service của bạn → tab <b>Variables</b> → thêm biến <code>CF_ORIGIN_SECRET</code> = <b>đúng chuỗi y hệt</b> ở bước 1.</li>
            <li>Đảm bảo cũng đã có 2 biến <code>TRUST_CF_HEADER=1</code> và <code>CANONICAL_HOST=<domain thật của bạn qua Cloudflare></code>. Deploy lại.</li>
          </ol>
          <div style="margin-top:10px;padding:10px;background:var(--fill);border-radius:8px;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span style="color:var(--text2);font-size:12px">Chuỗi bí mật gợi ý (dùng luôn cho cả 2 nơi ở bước 1 và 2, sinh mới mỗi lần restart server):</span>
            <code id="originSecretSuggest" style="background:var(--code-bg);padding:4px 8px;border-radius:6px;word-break:break-all"><%=ipDiag.suggestedSecret%></code>
            <button type="button" class="btn btn-sm btn-outline" onclick="navigator.clipboard.writeText(document.getElementById('originSecretSuggest').textContent);this.textContent='✅ Đã copy'">📋 Copy</button>
          </div>
          <div style="margin-top:6px;color:var(--text2);font-size:11.5px">⚠️ Chuỗi này chỉ là gợi ý hiển thị lúc bạn đang xem trang — nếu server restart nó sẽ đổi. Copy dùng NGAY trong lúc cấu hình, đừng để cách quãng nhiều ngày.</div>
        </div>
        <%}else if(!ipDiag.originSecretSeenOnThisRequest){%>
        <div class="alert" style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);color:var(--gold);margin-top:10px">⚠️ Đã đặt <code>CF_ORIGIN_SECRET</code> trên Railway, nhưng chính request đang tải trang admin này lại KHÔNG mang đúng header bí mật — nghĩa là Transform Rule trên Cloudflare chưa hoạt động đúng (có thể chưa lưu, áp dụng sai domain, hoặc bạn đang truy cập trực tiếp domain Railway gốc thay vì qua Cloudflare). Kiểm tra lại rule ở Cloudflare Dashboard.</div>
        <%}else{%>
        <div class="alert" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);color:var(--ok-text);margin-top:10px">✅ Đã cấu hình đúng và đang hoạt động — IP hiển thị từ giờ là IP thật của người dùng, không thể giả mạo qua đường vòng domain gốc Railway nữa.</div>
        <%}%>
      </div>

      <div class="card" style="margin-bottom:16px">
        <div class="card-title">🌐 Chống VPN/Proxy/Hosting & mạng di động (4G/3G)</div>
        <div style="font-size:12.5px;color:var(--text2);margin-bottom:10px">Tự động tra cứu IP của người vượt link (qua ip-api.com, có cache 24h) để phát hiện VPN/Proxy/Hosting hoặc mạng di động — nhiều nhà cung cấp link rút gọn cấm dùng các mạng này. Giống mọi lớp chống gian lận khác của hệ thống: KHÔNG tự động từ chối, chỉ đưa vào "chờ duyệt" để admin tự quyết.</div>
        <form method="POST" action="/admin/settings">
          <div class="fg"><label>Bật tính năng tra cứu IP</label>
            <select name="ipintel_enabled">
              <option value="1" <%=settings.ipintel_enabled!=='0'?'selected':''%>>Bật</option>
              <option value="0" <%=settings.ipintel_enabled==='0'?'selected':''%>>Tắt</option>
            </select>
          </div>
          <div class="fg"><label>Giữ lại chờ duyệt nếu phát hiện VPN/Proxy/Hosting</label>
            <select name="ipintel_hold_vpn">
              <option value="1" <%=settings.ipintel_hold_vpn!=='0'?'selected':''%>>Bật</option>
              <option value="0" <%=settings.ipintel_hold_vpn==='0'?'selected':''%>>Tắt</option>
            </select>
          </div>
          <div class="fg"><label>Giữ lại chờ duyệt nếu phát hiện mạng di động (4G/3G)</label>
            <select name="ipintel_hold_mobile">
              <option value="1" <%=settings.ipintel_hold_mobile!=='0'?'selected':''%>>Bật</option>
              <option value="0" <%=settings.ipintel_hold_mobile==='0'?'selected':''%>>Tắt</option>
            </select>
          </div>
          <button class="btn btn-primary" type="submit">💾 Lưu</button>
        </form>
      </div>

      <div class="card" style="margin-bottom:16px">
        <div class="card-title">⚡ Cầu dao Ncoin/giờ</div>
        <div style="display:flex;gap:20px;flex-wrap:wrap;margin-bottom:14px">
          <div>Trạng thái: <%if(breakerStatus.active){%><span class="badge badge-danger">🔴 ĐANG TẠM DỪNG</span><%}else{%><span class="badge badge-success">🟢 Bình thường</span><%}%></div>
          <div>Ncoin/giờ hiện tại: <b><%=breakerStatus.rollingSum.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></b> / Ngưỡng: <b><%=breakerStatus.threshold.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></b></div>
          <%if(breakerStatus.active){%><div>Dự kiến tự resume: <b><%=new Date(breakerStatus.autoResumeAt).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></b> (nếu vẫn bất thường sẽ tự trigger lại)</div><%}%>
        </div>

        <form method="POST" action="/admin/breaker/threshold" style="display:flex;gap:8px;align-items:flex-end;margin-bottom:12px;flex-wrap:wrap">
          <div class="fg" style="margin:0"><label>Ngưỡng Ncoin/giờ</label><input type="number" name="threshold" min="1" value="<%=breakerStatus.threshold%>" style="width:180px"></div>
          <button class="btn btn-outline" type="submit">💾 Lưu ngưỡng</button>
        </form>

        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <%if(breakerStatus.active){%>
          <form method="POST" action="/admin/breaker/resume" onsubmit="return confirm('Resume cầu dao ngay bây giờ?')"><button class="btn btn-primary" type="submit">▶️ Resume ngay</button></form>
          <%}else{%>
          <form method="POST" action="/admin/breaker/trip" onsubmit="return confirm('Tạm dừng xác nhận nhiệm vụ ngay bây giờ?')">
            <input type="hidden" name="note" value="Tạm dừng khẩn cấp thủ công">
            <button class="btn btn-outline" type="submit" style="border-color:#ef4444;color:var(--bad)">⏸️ Tạm dừng thủ công</button>
          </form>
          <%}%>
        </div>

        <table style="margin-top:14px">
          <tr><th>Trigger lúc</th><th>Ncoin/giờ</th><th>Ngưỡng</th><th>Resume lúc</th><th>Bởi</th><th>Ghi chú</th></tr>
          <%breakerLogs.forEach(l=>{%>
          <tr>
            <td style="font-size:11px;color:var(--text2)"><%=new Date(parseInt(l.triggered_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td><%=l.ncoin_total.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td><%=l.threshold.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td style="font-size:11px;color:var(--text2)"><%=l.resumed_at?new Date(parseInt(l.resumed_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'}):'—'%></td>
            <td style="font-size:12px"><%=l.resumed_by||'—'%></td>
            <td style="font-size:12px;color:var(--text2)"><%=l.note||''%></td>
          </tr>
          <%})%>
        </table>
        <%if(breakerLogs.length===0){%><div style="text-align:center;padding:14px;color:var(--text2)">Chưa có lần trigger nào</div><%}%>
      </div>

      <%
      const heldKnown = ['breaker','duplicate_ip','duplicate_device','referer','quality_ip','vpn_proxy','mobile_network'];
      %>
      <div class="card" style="margin-bottom:16px" id="heldCard">
        <div class="card-title">⏳ Nhiệm vụ chờ duyệt (<span id="heldCount"><%=heldAttempts.length%></span>)</div>
        <div id="heldToolbarWrap" style="<%=heldAttempts.length===0?'display:none':''%>">
          <div class="held-toolbar">
            <label class="held-selall"><input type="checkbox" id="heldAll" onchange="heldToggleAll(this.checked)"> Chọn tất cả</label>
            <select id="heldReasonPick" onchange="heldPickReason(this.value);this.value=''" style="<%=sel%>;width:auto;padding:6px 10px;font-size:12px">
              <option value="">Chọn theo lý do…</option>
              <option value="breaker">⚡ Cầu dao</option>
              <option value="duplicate_ip">🔁 Trùng IP với TK khác</option>
              <option value="duplicate_device">🔁 Trùng thiết bị với TK khác</option>
              <option value="referer">🔗 Nghi ngờ bypass link</option>
              <option value="quality_ip">📶 Cần IP chất lượng</option>
              <option value="vpn_proxy">🛡️ VPN/Proxy</option>
              <option value="mobile_network">📱 Mạng 4G/3G</option>
              <option value="other">🕵️ Nghi vấn (khác)</option>
            </select>
            <span class="held-selcount" id="heldSelCount">Đã chọn 0</span>
            <button type="button" class="btn btn-primary" id="heldBtnApprove" style="padding:5px 12px;font-size:12px" disabled onclick="heldBulk('approve')">✅ Duyệt đã chọn</button>
            <button type="button" class="btn btn-outline" id="heldBtnReject" style="padding:5px 12px;font-size:12px;border-color:#ef4444;color:var(--bad)" disabled onclick="heldBulk('reject')">❌ Từ chối đã chọn</button>
          </div>
        </div>
        <div id="heldStatus" class="held-status" style="display:none"></div>
        <table id="heldTable">
          <tr><th style="width:28px"></th><th>Thời gian</th><th>User</th><th>Nhiệm vụ</th><th>Ncoin</th><th>Lý do giữ</th><th>Chi tiết</th><th>Hành động</th></tr>
          <%heldAttempts.forEach(a=>{ const rk = heldKnown.includes(a.held_reason) ? a.held_reason : 'other'; %>
          <tr data-held-id="<%=a.id%>" data-reason="<%=rk%>">
            <td><input type="checkbox" class="held-cb" value="<%=a.id%>" onchange="heldUpdate()"></td>
            <td style="font-size:11px;color:var(--text2)"><%=new Date(parseInt(a.completed_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td><b><%=a.username%></b></td>
            <td style="font-size:12px"><%=a.task_name%></td>
            <td><%=a.reward_actual.toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td><%if(a.held_reason==='breaker'){%><span class="badge badge-warning">⚡ Cầu dao</span><%}else if(a.held_reason==='duplicate_ip'){%><span class="badge" style="background:rgba(239,68,68,0.15);color:var(--bad)">🔁 Trùng IP với TK khác</span><%}else if(a.held_reason==='duplicate_device'){%><span class="badge" style="background:rgba(239,68,68,0.15);color:var(--bad)">🔁 Trùng thiết bị với TK khác</span><%}else if(a.held_reason==='referer'){%><span class="badge" style="background:rgba(96,165,250,0.15);color:var(--blue)">🔗 Nghi ngờ bypass link</span><%}else if(a.held_reason==='quality_ip'){%><span class="badge" style="background:rgba(168,85,247,0.15);color:var(--violet)">📶 Cần IP chất lượng</span><%}else if(a.held_reason==='vpn_proxy'){%><span class="badge" style="background:rgba(239,68,68,0.15);color:var(--bad)">🛡️ VPN/Proxy<%if(a.ip_isp){%> (<%=a.ip_isp%>)<%}%></span><%}else if(a.held_reason==='mobile_network'){%><span class="badge" style="background:rgba(251,146,60,0.15);color:var(--orange)">📱 Mạng 4G/3G<%if(a.ip_isp){%> (<%=a.ip_isp%>)<%}%></span><%}else{%><span class="badge badge-danger">🕵️ Nghi vấn</span><%}%></td>
            <td style="font-size:11px;color:var(--text2);max-width:220px"><%=a.fraud_reason||'—'%></td>
            <td style="white-space:nowrap">
              <button type="button" class="btn btn-primary" style="padding:4px 10px;font-size:12px" onclick="heldReview('approve',['<%=a.id%>'])">✅ Duyệt</button>
              <button type="button" class="btn btn-outline" style="padding:4px 10px;font-size:12px;border-color:#ef4444;color:var(--bad)" onclick="heldReview('reject',['<%=a.id%>'])">❌ Từ chối</button>
            </td>
          </tr>
          <%})%>
        </table>
        <div id="heldEmpty" style="text-align:center;padding:14px;color:var(--text2);<%=heldAttempts.length===0?'':'display:none'%>">Không có nhiệm vụ nào đang chờ duyệt</div>
      </div>

      <div class="card" style="margin-bottom:16px">
        <div class="card-title">🚩 Tài khoản nghi ngờ đa tài khoản/farm (<%=flaggedUsers.length%>)</div>
        <table>
          <tr><th>User</th><th>Điểm rủi ro</th><th>Chi tiết</th><th>IP đăng ký</th><th>Hành động</th></tr>
          <%flaggedUsers.forEach(u=>{%>
          <tr>
            <td><b><%=u.username%></b></td>
            <td><span class="badge badge-danger"><%=u.fraud_score%></span></td>
            <td style="font-size:11px;color:var(--text2);max-width:320px"><%=u.fraud_reason%></td>
            <td><span class="ip-badge"><%=u.reg_ip||'—'%></span></td>
            <td>
              <a href="/admin/user/<%=u.id%>/ips" class="btn btn-outline" style="padding:4px 10px;font-size:12px">🕵️ Xem IP</a>
              <form method="POST" action="/admin/users/<%=u.id%>/clear-fraud-flag" style="display:inline" onsubmit="return confirm('Gỡ cờ nghi ngờ cho tài khoản này? (sẽ tự gắn cờ lại nếu vẫn còn dấu hiệu ở lượt vượt link tiếp theo)')"><button class="btn btn-outline" style="padding:4px 10px;font-size:12px" type="submit">🏳️ Gỡ cờ</button></form>
            </td>
          </tr>
          <%})%>
        </table>
        <%if(flaggedUsers.length===0){%><div style="text-align:center;padding:14px;color:var(--text2)">Không có tài khoản nào bị gắn cờ</div><%}%>
      </div>

      <div class="card">
        <div class="card-title">📋 Nhật ký sự kiện bảo mật (100 gần nhất)</div>
        <table>
          <tr><th>Thời gian</th><th>Loại</th><th>IP</th><th>User ID</th><th>Chi tiết</th></tr>
          <%securityEvents.forEach(e=>{%>
          <tr>
            <td style="font-size:11px;color:var(--text2)"><%=new Date(parseInt(e.created_at)).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})%></td>
            <td style="font-size:12px"><%=e.event_type%></td>
            <td><span class="ip-badge"><%=e.ip||'—'%></span></td>
            <td style="font-size:12px"><%=e.user_id||'—'%></td>
            <td style="font-size:12px;color:var(--text2)"><%=e.detail%></td>
          </tr>
          <%})%>
        </table>
        <%if(securityEvents.length===0){%><div style="text-align:center;padding:14px;color:var(--text2)">Chưa có sự kiện nào</div><%}%>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="tab-panel" id="tab-content">
      <div class="card" style="margin-bottom:12px">
        <div class="card-title">📢 Thông báo banner</div>
        <form method="POST" action="/admin/announcements" style="display:flex;gap:8px;margin-bottom:12px">
          <input name="content" placeholder="Nội dung thông báo..." style="flex:1;<%=inp%>" required>
          <button class="btn btn-primary" type="submit">Thêm</button>
        </form>
        <table>
          <tr><th>Nội dung</th><th>Trạng thái</th><th></th></tr>
          <%announcements.forEach(a=>{%>
          <tr>
            <td style="font-size:13px"><%=a.content%></td>
            <td><%if(a.active){%><span class="badge badge-success">Hiện</span><%}else{%><span class="badge">Ẩn</span><%}%></td>
            <td style="display:flex;gap:4px">
              <form method="POST" action="/admin/announcements/<%=a.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=a.active?'Ẩn':'Hiện'%></button></form>
              <form method="POST" action="/admin/announcements/<%=a.id%>/delete"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <%})%>
        </table>
      </div>

      <div class="card" style="margin-bottom:12px">
        <div class="card-title">🔔 Popup thông báo (1 popup active tại 1 thời điểm)</div>
        <form method="POST" action="/admin/popups" style="display:grid;gap:8px;margin-bottom:12px">
          <input name="title" placeholder="Tiêu đề popup" style="<%=inp%>" required>
          <textarea name="content" placeholder="Nội dung (hỗ trợ xuống dòng)" rows="4" style="<%=inp%>;resize:vertical" required></textarea>
          <button class="btn btn-primary" style="width:fit-content" type="submit">➕ Tạo popup</button>
        </form>
        <table>
          <tr><th>Tiêu đề</th><th>Trạng thái</th><th></th></tr>
          <%popups.forEach(p=>{%>
          <tr>
            <td><%=p.title%></td>
            <td><%if(p.active){%><span class="badge badge-success">Active</span><%}else{%><span class="badge">Tắt</span><%}%></td>
            <td style="display:flex;gap:4px">
              <form method="POST" action="/admin/popups/<%=p.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=p.active?'Tắt':'Bật'%></button></form>
              <form method="POST" action="/admin/popups/<%=p.id%>/delete"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <%})%>
        </table>
      </div>

      <div class="card">
        <div class="card-title">📜 Quy định</div>
        <form method="POST" action="/admin/regulations" style="display:grid;gap:8px;margin-bottom:12px">
          <div style="display:flex;gap:8px">
            <input name="title" placeholder="Tiêu đề" style="flex:1;<%=inp%>" required>
            <input name="sort_order" type="number" placeholder="Thứ tự" style="width:80px;<%=inp%>" value="0">
          </div>
          <textarea name="content" placeholder="Nội dung quy định..." rows="6" style="<%=inp%>;resize:vertical" required></textarea>
          <div style="font-size:11px;color:var(--text3);line-height:1.6">Cú pháp: dòng thường = đoạn mở đầu · <code>- nội dung</code> = gạch đầu dòng · <code>**chữ đỏ**</code> = nhấn mạnh · dòng bắt đầu bằng <code>⚠ **Cảnh báo:** ...</code> = khung cảnh báo</div>
          <button class="btn btn-primary" style="width:fit-content" type="submit">➕ Thêm quy định</button>
        </form>
        <table>
          <tr><th>Tiêu đề</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr>
          <%regs.forEach(r=>{%>
          <tr>
            <td><%=r.title%></td><td style="color:var(--text2)"><%=r.sort_order%></td>
            <td><%if(r.active){%><span class="badge badge-success">Hiện</span><%}else{%><span class="badge">Ẩn</span><%}%></td>
            <td style="display:flex;gap:4px">
              <form method="POST" action="/admin/regulations/<%=r.id%>/toggle"><button class="btn btn-sm btn-warning" type="submit"><%=r.active?'Ẩn':'Hiện'%></button></form>
              <form method="POST" action="/admin/regulations/<%=r.id%>/delete"><button class="btn btn-sm btn-danger" type="submit">Xóa</button></form>
            </td>
          </tr>
          <%})%>
        </table>
      </div>
    </div>

    <!-- SETTINGS -->
    <div class="tab-panel" id="tab-settings">
      <div class="card">
        <div class="card-title">⚙️ Cài đặt hệ thống</div>
        <form method="POST" action="/admin/settings">
          <div class="fg"><label>Ncoin rút tối thiểu</label><input name="withdraw_min" type="number" value="<%=settings.withdraw_min||20000%>"></div>
          <div class="card-title" style="margin-top:16px">💸 Phí rút tiền theo cấp độ</div>
          <div class="grid3" style="margin-bottom:12px">
            <div class="fg"><label>🔵 Rookie (đ)</label><input name="withdraw_fee_rookie" type="number" value="<%=settings.withdraw_fee_rookie||3000%>"></div>
            <div class="fg"><label>🌿 Silver (đ)</label><input name="withdraw_fee_silver" type="number" value="<%=settings.withdraw_fee_silver||2500%>"></div>
            <div class="fg"><label>⭐ Gold (đ)</label><input name="withdraw_fee_gold" type="number" value="<%=settings.withdraw_fee_gold||2000%>"></div>
            <div class="fg"><label>🔥 Platinum (đ)</label><input name="withdraw_fee_platinum" type="number" value="<%=settings.withdraw_fee_platinum||1500%>"></div>
            <div class="fg"><label>💎 Diamond (đ)</label><input name="withdraw_fee_diamond" type="number" value="<%=settings.withdraw_fee_diamond||1000%>"></div>
            <div class="fg"><label>👑 Legend (đ)</label><input name="withdraw_fee_legend" type="number" value="<%=settings.withdraw_fee_legend||0%>"></div>
          </div>
          <div class="fg"><label>Vcoin khóa bao nhiêu ngày</label><input name="vcoin_lockdays" type="number" value="<%=settings.vcoin_lockdays||28%>"></div>
          <div class="fg"><label>Thông báo trang rút tiền</label><textarea name="withdraw_notice" rows="2"><%=settings.withdraw_notice||''%></textarea></div>
          <div class="fg"><label>Thông tin ngân hàng admin</label><textarea name="admin_bank" rows="3"><%=settings.admin_bank||''%></textarea></div>
          <div class="fg"><label>Hướng dẫn nạp Vcoin</label><textarea name="topup_guide" rows="5"><%=settings.topup_guide||''%></textarea></div>
          <div class="fg"><label>Thông báo trang nạp Vcoin</label><input name="topup_notice" value="<%=settings.topup_notice||''%>"></div>
          <button class="btn btn-primary" type="submit">💾 Lưu cài đặt</button>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
// VA LOI DA SUA (2026-09): ham filterUserSelect() cu chi loc TREN <select> da
// duoc render san voi toi da 100 user gan nhat - gio goi API
// /admin/users/search de tim tren TOAN BO user, khong bi gioi han 100 nua.
let userSearchTimers = {};
function searchUserSelect(input, selectId) {
  const q = input.value.trim();
  const select = document.getElementById(selectId);
  clearTimeout(userSearchTimers[selectId]);
  if (!q) return; // o trong: giu nguyen danh sach mac dinh (100 user moi nhat) de form van dung duoc ngay
  userSearchTimers[selectId] = setTimeout(async () => {
    try {
      const res = await fetch('/admin/users/search?q=' + encodeURIComponent(q));
      const rows = await res.json();
      select.innerHTML = '';
      if (rows.length === 0) {
        const opt = document.createElement('option');
        opt.textContent = 'Không tìm thấy user nào';
        opt.disabled = true;
        select.appendChild(opt);
        return;
      }
      rows.forEach(u => {
        const opt = document.createElement('option');
        opt.value = u.id;
        opt.textContent = (selectId === 'buffSelect1') ? `${u.username} (${u.ncoin}N/${u.vcoin}V)` : u.username;
        select.appendChild(opt);
      });
    } catch (e) { console.error('Lỗi tìm user:', e); }
  }, 300);
}
// ===== Duyet / tu choi nhiem vu cho duyet: KHONG reload trang, ho tro hang loat =====
let heldBusy = false;
function heldRows() { return Array.from(document.querySelectorAll('#heldTable tr[data-held-id]')); }
function heldSelected() { return Array.from(document.querySelectorAll('#heldTable .held-cb:checked')).map(cb => cb.value); }
function heldUpdate() {
  const n = heldSelected().length, total = heldRows().length;
  document.getElementById('heldSelCount').textContent = 'Đã chọn ' + n;
  document.getElementById('heldBtnApprove').disabled = heldBusy || n === 0;
  document.getElementById('heldBtnReject').disabled = heldBusy || n === 0;
  const all = document.getElementById('heldAll');
  all.checked = total > 0 && n === total;
  all.indeterminate = n > 0 && n < total;
  document.getElementById('heldCount').textContent = total;
}
function heldToggleAll(v) { document.querySelectorAll('#heldTable .held-cb').forEach(cb => { cb.checked = v; }); heldUpdate(); }
function heldPickReason(reason) {
  if (!reason) return;
  heldRows().forEach(tr => { if (tr.dataset.reason === reason) tr.querySelector('.held-cb').checked = true; });
  heldUpdate();
}
function heldBulk(action) { const ids = heldSelected(); if (ids.length) heldReview(action, ids); }
async function heldReview(action, ids) {
  if (heldBusy) return;
  const isApprove = action === 'approve';
  if (!isApprove && !confirm('Từ chối ' + ids.length + ' lượt? Sẽ KHÔNG cộng Ncoin cho người dùng.')) return;
  if (isApprove && ids.length > 1 && !confirm('Duyệt ' + ids.length + ' lượt? Ncoin sẽ được cộng cho người dùng.')) return;

  heldBusy = true; heldUpdate();
  const status = document.getElementById('heldStatus');
  status.style.display = 'block'; status.className = 'held-status';
  const CHUNK = 20, failed = [];
  let done = 0, fatal = '';
  try {
    for (let i = 0; i < ids.length; i += CHUNK) {
      const part = ids.slice(i, i + CHUNK);
      status.textContent = '⏳ Đang xử lý ' + Math.min(i + part.length, ids.length) + '/' + ids.length + '…';
      const res = await fetch('/admin/attempts/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
        body: new URLSearchParams({ action: action, ids: part.join(',') })
      });
      let data;
      try { data = await res.json(); } catch (e) { throw new Error('Máy chủ trả về lỗi (HTTP ' + res.status + ')'); }
      if (!res.ok || !data.ok) throw new Error(data.error || 'Lỗi không xác định');
      data.done.forEach(id => {
        const tr = document.querySelector('#heldTable tr[data-held-id="' + id + '"]');
        if (tr) tr.remove();
        done++;
      });
      data.failed.forEach(f => {
        failed.push(f);
        // Luot da duoc xu ly boi nguoi khac / tab khac -> cung go khoi danh sach
        if (/không ở trạng thái chờ duyệt/.test(f.error)) {
          const tr = document.querySelector('#heldTable tr[data-held-id="' + f.id + '"]');
          if (tr) tr.remove();
        }
      });
    }
  } catch (e) { fatal = e.message; }

  heldBusy = false; heldUpdate();
  if (heldRows().length === 0) {
    document.getElementById('heldToolbarWrap').style.display = 'none';
    document.getElementById('heldEmpty').style.display = 'block';
  }
  const verb = isApprove ? 'duyệt' : 'từ chối';
  const realFailed = failed.filter(f => !/không ở trạng thái chờ duyệt/.test(f.error));
  if (!fatal && realFailed.length === 0) {
    status.className = 'held-status ok';
    status.textContent = '✅ Đã ' + verb + ' ' + done + ' lượt.' + (failed.length ? ' (' + failed.length + ' lượt đã được xử lý trước đó)' : '');
  } else {
    status.className = 'held-status err';
    const detail = realFailed.slice(0, 5).map(f => '#' + f.id + ': ' + f.error).join(' · ');
    status.textContent = '⚠️ Đã ' + verb + ' ' + done + ' lượt, ' + (realFailed.length + (fatal ? 1 : 0)) + ' lỗi. ' + (fatal ? fatal + '. ' : '') + detail + (fatal ? ' — tải lại trang để xem trạng thái mới nhất.' : '');
  }
}

function showTab(id, btn) {
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  btn.classList.add('active');
}
const hash = location.hash.replace('#','');
if(hash) {
  const btn = document.querySelector(`.tab-btn[onclick="showTab('${hash}',this)"]`);
  if(btn) { showTab(hash, btn); }
}
</script>
</body></html>
