<!DOCTYPE html><html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Nạp Vcoin - 4ummo</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/coins.css">
<script src="/js/menu.js" defer></script></head><body>
<%- include('partials/sidebar',{page:'topup',user}) %>
<%- include('partials/popup') %>
<div class="main" id="main">
  <%- include('partials/topbar') %>
  <div class="topbar"><div class="topbar-title">💎 Nạp Vcoin</div></div>
  <div class="page">
    <%if(ok){%><div class="alert alert-success">✅ Yêu cầu đã gửi!</div><%}%>
    <%if(settings.topup_notice){%><div class="alert alert-info">ℹ️ <%=settings.topup_notice%></div><%}%>

    <div style="background:linear-gradient(135deg,rgba(96,165,250,0.15),rgba(124,58,237,0.15));border:1px solid rgba(96,165,250,0.2);border-radius:14px;padding:20px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center">
      <div>
        <div style="font-size:12px;color:var(--text2)">Vcoin hiện có</div>
        <div style="font-size:32px;font-weight:800;color:#60a5fa;display:flex;align-items:center;gap:8px"><span class="vi lg">V</span><%=user.vcoin.toLocaleString('vi-VN')%></div>
      </div>
      <div style="text-align:right;font-size:12px;color:var(--text2)">
        <div>Vcoin nạp vào cần chờ</div>
        <div style="font-size:18px;font-weight:700;color:#f59e0b"><%=lockDays%> ngày</div>
        <div>mới được rút ra</div>
      </div>
    </div>

    <div class="grid2">
      <div class="card">
        <div class="card-title">📋 Hướng dẫn nạp Vcoin</div>
        <div style="font-size:13px;color:var(--text2);line-height:1.9;white-space:pre-wrap"><%=settings.topup_guide||'Liên hệ admin để nạp Vcoin.'%></div>
        <%if(settings.admin_bank){%>
        <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:14px;margin-top:14px;">
          <div style="font-size:11px;color:var(--text2);margin-bottom:6px">THÔNG TIN THANH TOÁN</div>
          <div style="font-size:13px;white-space:pre-wrap"><%=settings.admin_bank%></div>
        </div>
        <%}%>
        <div style="background:rgba(96,165,250,0.08);border-radius:10px;padding:12px;margin-top:12px;font-size:13px">
          <b style="color:#60a5fa">Nội dung chuyển khoản:</b><br>
          <span style="font-size:15px;font-weight:700">NapVcoin_<%=user.username%></span>
        </div>
        <div style="margin-top:12px;padding:10px;background:rgba(245,158,11,0.08);border-radius:10px;font-size:12px;color:#f59e0b">
          💡 Tỷ lệ: 1.000đ = 1 Vcoin · Vcoin nạp chờ <%=lockDays%> ngày mới rút được
        </div>
      </div>

      <div class="card">
        <div class="card-title">📜 Lịch sử nạp Vcoin</div>
        <table>
          <tr><th>Ngày</th><th>Số lượng</th><th>Rút được sau</th></tr>
          <%history.forEach(h=>{%>
          <tr>
            <td style="font-size:12px;color:var(--text2)"><%=new Date(parseInt(h.created_at)).toLocaleDateString('vi-VN')%></td>
            <td style="color:#60a5fa;font-weight:600">+<%=h.amount.toLocaleString('vi-VN')%>V</td>
            <td style="font-size:12px">
              <%if(Date.now()>=parseInt(h.withdrawable_at)){%>
              <span style="color:#10b981">✅ Đã mở khóa</span>
              <%}else{%>
              <span style="color:#f59e0b"><%=new Date(parseInt(h.withdrawable_at)).toLocaleDateString('vi-VN')%></span>
              <%}%>
            </td>
          </tr>
          <%})%>
        </table>
        <%if(history.length===0){%><div style="text-align:center;padding:20px;color:var(--text2)">Chưa có lịch sử nạp</div><%}%>
      </div>
    </div>
  </div>
</div>
</body></html>
